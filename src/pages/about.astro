---
import Default from "@/layouts/default.astro";
import Sidebar from "@/components/sidebar.astro";
import Comments from "@/components/comments.astro";
import { profileConfig, siteConfig } from "@/config";
import Icon from "@/components/icon.astro";

const features = [
  {
    icon: "folder",
    title: "技术栈",
    desc: "基于 Astro 构建，Tailwind CSS 驱动，默认零 JS、极致轻量。",
  },
  {
    icon: "palette",
    title: "设计语言",
    desc: "樱花粉主题，支持亮色 / 暗色 / 跟随系统三种模式无缝切换。",
  },
  {
    icon: "message",
    title: "互动交流",
    desc: "文章评论、朋友圈动态，欢迎随时来聊 ~(￣▽￣)~",
  },
];

const stats = [
  { icon: "sun", value: "3 种", label: "主题模式" },
  { icon: "link", value: "Cloudflare", label: "边缘部署" },
  { icon: "mail", value: "随时", label: "欢迎来信" },
];

const timeline = [
  { date: "2022", title: "站点诞生", desc: "在角落里悄悄搭起这个小窝，开始记录生活碎片。" },
  { date: "2024", title: "拥抱 Astro", desc: "用 Astro 重构，享受极致轻量与零 JS 的清爽。" },
  { date: "2025", title: "樱花粉主题", desc: "换上喜欢的樱花粉，亮色暗色随心切换。" },
  { date: "至今", title: "持续折腾", desc: "写代码、写生活，也写写那些不务正业的小玩意。" },
];

const skills = [
  { name: "Astro", level: 92 },
  { name: "Tailwind CSS", level: 88 },
  { name: "TypeScript", level: 80 },
  { name: "Svelte", level: 70 },
  { name: "React", level: 68 },
];

const year = new Date().getFullYear();
---

<Default title="关于我">
  <div slot="sidebar">
    <Sidebar headings={[]} />
  </div>

  <section class="about">
    <div class="about-hero card reveal" data-ripple>
      <span class="hero-glow hero-glow-a"></span>
      <span class="hero-glow hero-glow-b"></span>
      <div class="hero-avatar-wrap">
        <div class="hero-ring"></div>
        <img
          src={profileConfig.avatar}
          alt={profileConfig.name}
          class="about-avatar"
        />
      </div>
      <div class="hero-info">
        <div class="hero-hello">
          <span class="hero-wave">👋</span> 你好，我是
        </div>
        <h1 class="about-name">{profileConfig.name}</h1>
        <p class="about-role">
          <Icon name="star" size={13} />
          一个喜欢折腾与分享的小站长
        </p>
        <p class="about-bio">{profileConfig.bio}</p>
        <div class="hero-tags">
          <span class="hero-tag">Astro</span>
          <span class="hero-tag">Tailwind</span>
          <span class="hero-tag">粉色控</span>
          <span class="hero-tag">狐狸</span>
        </div>
        <div class="about-socials">
          {
            profileConfig.social.map((s) => (
              <a
                href={s.url}
                title={s.name}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="about-social"
                data-ripple
              >
                <Icon name={s.icon} size={18} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="about-card prose reveal" data-ripple>
      <h2>关于这里</h2>
      <p>
        这里是一个藏在角落的小站，记录着关于代码、生活和美好事物的碎片。
        我喜欢咖啡与阅读，也喜欢把折腾过的东西写下来分享给大家。
      </p>
      <h2>这个站点</h2>
      <ul>
        <li>基于 <strong>Astro</strong> 构建，极致轻量、默认零 JS。</li>
        <li>样式使用 <strong>Tailwind CSS</strong>，支持亮色 / 暗色 / 跟随系统。</li>
        <li>评论与互动欢迎通过社交账号联系我 ~(￣▽￣)~</li>
      </ul>
    </div>

    <div class="about-features">
      {
        features.map((f, i) => (
          <div
            class="feat card reveal"
            data-ripple
            style={`--reveal-delay:${i * 80}ms`}
          >
            <div class="feat-icon">
              <Icon name={f.icon} size={20} />
            </div>
            <div class="feat-title">{f.title}</div>
            <p class="feat-desc">{f.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="about-block reveal">
      <h2 class="about-block-title">技能栈</h2>
      <div class="skills card" data-ripple>
        {
          skills.map((s) => (
            <div class="skill">
              <div class="skill-head">
                <span class="skill-name">{s.name}</span>
                <span class="skill-pct">{s.level}%</span>
              </div>
              <div class="skill-bar">
                <div class="skill-fill" style={`--lv:${s.level}%`} />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="about-block reveal">
      <h2 class="about-block-title">足迹</h2>
      <ul class="timeline about-timeline">
        {
          timeline.map((t) => (
            <li class="tl-item">
              <span class="tl-dot" />
              <div class="tl-card">
                <div class="tl-date">{t.date}</div>
                <div class="tl-title">{t.title}</div>
                <div class="tl-content">{t.desc}</div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about-stats">
      {
        stats.map((s, i) => (
          <div
            class="stat card reveal"
            data-ripple
            style={`--reveal-delay:${i * 80}ms`}
          >
            <div class="stat-icon">
              <Icon name={s.icon} size={18} />
            </div>
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))
      }
    </div>

    <Comments />
  </section>
</Default>

<style lang="scss">
  .about {
    @apply max-w-2xl mx-auto px-1 py-6;
  }

  /* Hero */
  .about-hero {
    @apply relative flex items-center gap-6 mt-4 p-6 overflow-hidden;
  }
  .hero-glow {
    @apply absolute rounded-full pointer-events-none blur-2xl opacity-50;
  }
  .hero-glow-a {
    width: 180px;
    height: 180px;
    top: -60px;
    right: -40px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--primary) 55%, transparent),
      transparent 70%
    );
  }
  .hero-glow-b {
    width: 140px;
    height: 140px;
    bottom: -50px;
    left: -30px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--primary) 30%, transparent),
      transparent 70%
    );
  }
  .hero-avatar-wrap {
    @apply relative shrink-0;
  }
  .hero-ring {
    @apply absolute -inset-1.5 rounded-full;
    background: conic-gradient(
      from 0deg,
      color-mix(in oklab, var(--primary) 70%, transparent),
      color-mix(in oklab, var(--primary) 15%, transparent),
      color-mix(in oklab, var(--primary) 70%, transparent)
    );
  }
  .about-avatar {
    @apply relative w-28 h-28 rounded-full object-cover border-4
           border-(--card-bg);
    box-shadow: 0 10px 30px -10px color-mix(in oklab, var(--primary) 65%, transparent);
  }
  .hero-info {
    @apply relative min-w-0 flex-1;
  }
  .hero-hello {
    @apply text-sm text-(--muted) mb-0.5;
    .hero-wave {
      @apply inline-block;
      animation: hero-wave 2.4s ease-in-out infinite;
    }
  }
  .about-name {
    @apply text-3xl font-bold text-(--text) leading-tight;
  }
  .about-role {
    @apply inline-flex items-center gap-1 text-sm text-(--primary)
           font-medium mt-1.5;
  }
  .about-bio {
    @apply text-sm text-(--muted) mt-3 leading-relaxed;
  }
  .hero-tags {
    @apply flex flex-wrap gap-2 mt-3.5;
  }
  .hero-tag {
    @apply text-xs px-2.5 py-1 rounded-full border border-(--border)
           bg-(--card-bg) text-(--muted) transition
           hover:text-(--primary) hover:border-(--primary)/40;
  }
  .about-socials {
    @apply flex items-center gap-2.5 mt-4;
  }
  .about-social {
    @apply w-9 h-9 rounded-full flex items-center justify-center
           border border-(--border) text-(--muted)
           transition hover:text-(--primary) hover:border-(--primary)
           hover:-translate-y-0.5 active:scale-95;
  }

  @keyframes hero-wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(16deg); }
    50% { transform: rotate(0deg); }
    75% { transform: rotate(-8deg); }
  }

  @media (max-width: 560px) {
    .about-hero {
      @apply flex-col text-center;
    }
    .hero-info {
      @apply flex flex-col items-center;
    }
    .about-socials {
      @apply justify-center;
    }
  }

  .about-card {
    @apply rounded-xl border border-(--border) p-6 mt-4
           bg-(--card-bg);
  }

  .about-block {
    @apply mt-8;
  }
  .about-block-title {
    @apply text-lg font-bold text-(--text) mb-4 relative pl-3;
    &::before {
      content: "";
      @apply absolute left-0 top-1/2 -translate-y-1/2 w-1 h-4 rounded-full
             bg-(--primary);
    }
  }

  .about-features {
    @apply grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4;
  }
  .feat {
    @apply rounded-xl border border-(--border) p-4 text-left
           bg-(--card-bg) transition hover:-translate-y-0.5
           hover:shadow-md hover:border-(--primary)/40;
    .feat-icon {
      @apply w-10 h-10 rounded-lg flex items-center justify-center mb-2
             bg-(--primary)/12 text-(--primary);
    }
    .feat-title {
      @apply text-sm font-semibold text-(--text);
    }
    .feat-desc {
      @apply text-xs text-(--muted) mt-1 leading-relaxed;
    }
  }

  .skills {
    @apply rounded-xl border border-(--border) p-5 space-y-4
           bg-(--card-bg);
  }
  .skill-head {
    @apply flex items-center justify-between mb-1.5;
  }
  .skill-name {
    @apply text-sm font-medium text-(--text);
  }
  .skill-pct {
    @apply text-xs text-(--muted) font-mono;
  }
  .skill-bar {
    @apply h-2 rounded-full overflow-hidden bg-(--border)/50;
  }
  .skill-fill {
    @apply h-full rounded-full;
    width: var(--lv);
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--primary) 70%, transparent),
      var(--primary)
    );
    transition: width 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .about-timeline {
    @apply mt-1;
    .tl-card {
      @apply transition hover:border-(--primary)/40;
    }
    .tl-title {
      @apply text-sm font-semibold text-(--text) mt-0.5;
    }
  }

  .about-stats {
    @apply grid grid-cols-3 gap-3 mt-4;
  }
  .stat {
    @apply rounded-lg border border-(--border) p-4 text-center
           bg-(--card-bg);
    .stat-icon {
      @apply inline-flex items-center justify-center w-7 h-7 rounded-full
             bg-(--primary)/12 text-(--primary) mb-1.5;
    }
    .stat-value {
      @apply text-sm font-semibold text-(--text);
    }
    .stat-label {
      @apply text-xs text-(--muted) mt-0.5;
    }
  }
</style>
