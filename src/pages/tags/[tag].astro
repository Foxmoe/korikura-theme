---
import Default from "@/layouts/default.astro";
import Sidebar from "@/components/sidebar.astro";
import PostCard from "@/components/post-card.astro";
import Icon from "@/components/icon.astro";
import { getPublishedPosts } from "@/utils/posts";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const map = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!map.has(tag)) map.set(tag, []);
      map.get(tag)!.push(post);
    }
  }
  return [...map.entries()].map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<Default title={`标签：${tag}`}>
  <section class="taxonomy">
    <nav class="crumb">
      <a href="/tags">标签</a>
      <Icon name="chevron" size={14} />
      <span>#{tag}</span>
    </nav>
    <h1 class="tax-title">
      <Icon name="hash" size={20} /> {tag}
    </h1>
    <p class="tax-sub">共 {posts.length} 篇文章</p>

    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <div slot="sidebar">
    <Sidebar />
  </div>
</Default>

<style lang="scss">
  .taxonomy {
    @apply max-w-5xl mx-auto px-1 py-4;
  }
  .crumb {
    @apply flex items-center gap-1 text-xs text-(--muted) mb-3;
    a {
      @apply no-underline hover:text-(--primary);
    }
  }
  .tax-title {
    @apply text-3xl font-bold flex items-center gap-2 text-(--text);
  }
  .tax-sub {
    @apply text-sm text-(--muted) mt-1 mb-6;
  }
  .post-grid {
    @apply grid gap-6 sm:grid-cols-2 lg:grid-cols-3;
  }
</style>
