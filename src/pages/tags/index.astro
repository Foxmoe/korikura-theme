---
import Default from "@/layouts/default.astro";
import Sidebar from "@/components/sidebar.astro";
import { getTagCounts } from "@/utils/posts";
import { tagToSlug } from "@/utils/utils";
import Icon from "@/components/icon.astro";

const tags = await getTagCounts();
const max = tags.length ? Math.max(...tags.map((t) => t.count)) : 1;
const min = tags.length ? Math.min(...tags.map((t) => t.count)) : 1;
function size(count: number) {
  if (max === min) return 0.95;
  return 0.8 + ((count - min) / (max - min)) * 0.7;
}
---

<Default title="标签">
  <section class="taxonomy">
    <div class="tax-head">
      <h1 class="tax-title">
        <Icon name="tag" size={22} /> 全部标签
      </h1>
      <p class="tax-sub">共 {tags.length} 个标签</p>
    </div>

    {
      tags.length === 0 ? (
        <p class="tax-empty">暂无标签</p>
      ) : (
        <div class="cloud">
          {tags.map((t) => (
            <a
              href={`/tags/${tagToSlug(t.name)}`}
              class="cloud-tag"
              style={`font-size:${size(t.count).toFixed(2)}rem`}
            >
              #{t.name}
              <sup>{t.count}</sup>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <div slot="sidebar">
    <Sidebar />
  </div>
</Default>

<style lang="scss">
  .taxonomy {
    @apply max-w-3xl mx-auto px-1 py-4;
  }
  .tax-head {
    @apply mb-8;
  }
  .tax-title {
    @apply text-3xl font-bold flex items-center gap-2 text-[var(--text)];
  }
  .tax-sub {
    @apply text-sm text-[var(--muted)] mt-1;
  }
  .tax-empty {
    @apply text-[var(--muted)];
  }
  .cloud {
    @apply flex flex-wrap gap-3;
  }
  .cloud-tag {
    @apply inline-flex items-start px-3 py-1.5 rounded-full no-underline
           bg-[var(--primary)]/8 text-[var(--text)]
           border border-[var(--border)] transition;
    &:hover {
      @apply bg-[var(--primary)]/18 text-[var(--primary)] -translate-y-0.5;
    }
    sup {
      @apply text-xs ml-0.5 text-[var(--muted)];
    }
  }
</style>
