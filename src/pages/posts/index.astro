---
import Default from "@/layouts/default.astro";
import Sidebar from "@/components/sidebar.astro";
import PostCard from "@/components/post-card.astro";
import Pagination from "@/components/pagination.astro";
import Icon from "@/components/icon.astro";
import { getPublishedPosts } from "@/utils/posts";
import { siteConfig } from "@/config";
import { PAGE_SIZE } from "@/constants/constants";

const pageSize = PAGE_SIZE;
const all = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(all.length / pageSize));
const posts = all.slice(0, pageSize);
---

<Default title="文章">
  <div slot="hero" class="hero-banner">
    <img
      class="hero-banner-img"
      src={siteConfig.defaultCover}
      alt=""
      onerror="this.style.display='none'"
    />
  </div>

  <section class="posts-section">
    <div class="section-header">
      <h2 class="section-title">全部文章</h2>
      <span class="section-more">{all.length} 篇</span>
    </div>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} horizontal />)}
    </div>

    <Pagination currentPage={1} totalPages={totalPages} />
  </section>

  <div slot="sidebar">
    <Sidebar />
  </div>
</Default>

<style lang="scss">
  
  .hero-banner {
    @apply relative w-full overflow-hidden;
    aspect-ratio: 21 / 7;
    margin-top: calc(-1 * (var(--nav-h) + 8px));
    border-bottom: 1px solid var(--border);
  }
  .hero-banner-img {
    @apply w-full h-full object-cover;
  }

  .posts-section {
    @apply container mx-auto px-2 pb-20 pt-8;
  }
  .section-header {
    @apply flex items-center justify-between mb-6;
  }
  .section-title {
    @apply text-xl font-bold text-(--text) relative pl-3;
    &::before {
      content: "";
      @apply absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5 rounded-full bg-(--primary);
    }
  }
  .section-more {
    @apply text-sm text-(--muted);
  }
  .post-list {
    @apply flex flex-col gap-4;
  }
</style>
