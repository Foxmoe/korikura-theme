---
// posts list page

import Default from "@/layouts/default.astro";
import { getCollection } from "astro:content";
import { formatDateToChinese } from "@/utils/utils";
import Pagination from "@/components/pagination.astro";

const posts = await getCollection("posts");

// 分页参数
const pageSize = 10;
const currentPage = parseInt(Astro.url.searchParams.get("page") || "1");
const totalPages = Math.ceil(posts.length / pageSize);
const start = (currentPage - 1) * pageSize;
const paginatedPosts = posts.slice(start, start + pageSize);
---

<Default>
  <div class="posts-page">
    <h1 class="page-title">文章列表</h1>
    <p class="post-count">共计 {posts.length} 篇文章</p>

    <ul class="post-list">
      {paginatedPosts.map((post) => (
        <li class="post-item">
          <a class="post-link" href={`/posts/${post.id}`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{formatDateToChinese(post.data.pubDate)}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- 引入分页组件 -->
    <Pagination 
      currentPage={currentPage} 
      totalPages={totalPages} 
      baseUrl={Astro.url.pathname}
    />
  </div>
</Default>

<style lang="scss">
  .posts-page {
    @apply max-w-2xl mx-auto px-6 py-16;
  }

  .page-title {
    @apply text-4xl font-bold tracking-tight text-gray-900 mb-2;
  }

  .post-count {
    @apply text-gray-500 mb-8 text-sm;
  }

  .post-list {
    @apply list-none p-0 m-0 flex flex-col gap-5;
  }

  .post-item {
    @apply rounded-xl bg-white border border-gray-100 transition-all duration-200 shadow-sm;
    &:hover {
      @apply border-gray-300 shadow-md -translate-y-0.5;
    }
  }

  .post-link {
    @apply flex justify-between items-baseline p-5 no-underline text-inherit gap-4 flex-wrap;
  }

  .post-title {
    @apply text-lg font-semibold text-gray-900 leading-snug;
  }

  .post-date {
    @apply text-sm text-gray-400 whitespace-nowrap tabular-nums;
  }
</style>