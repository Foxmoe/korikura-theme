---
import Base from "./base.astro";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  showSidebar?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  postTitle?: string;
}

const {
  title,
  description,
  keywords,
  showSidebar = true,
  ogType,
  ogImage,
  publishedTime,
  modifiedTime,
  tags,
  author,
  postTitle,
} = Astro.props;
---

<Base
  {title}
  {description}
  {keywords}
  {ogType}
  {ogImage}
  {publishedTime}
  {modifiedTime}
  {tags}
  {author}
>
  <div class="layout">
    <header class="header">
      <Navbar postTitle={postTitle} />
    </header>

    <div id="hero-slot" class="hero-slot">
      <slot name="hero" />
    </div>

    <main id="main-container" tabindex="-1">
      <div class="article-content">
        <slot />
      </div>
      {
        showSidebar && (
          <div class="sidebar-container">
            <slot name="sidebar" />
          </div>
        )
      }
    </main>

    <Footer />
  </div>
</Base>

<style lang="scss">
  .layout {
    @apply min-h-screen flex flex-col;
  }
  #main-container {
    width: var(--container);
    margin: 0 auto;
    @apply flex gap-10 py-8 relative;
  }

  .article-content {
    @apply flex-1 min-w-0;
  }

  .sidebar-container {
    @apply w-72 hidden xl:flex shrink-0;
  }
</style>
