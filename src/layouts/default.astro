---
import Base from "./base.astro";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

import "@/styles/style.scss";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  showSidebar?: boolean;
}

const { title, description, keywords, showSidebar = true } = Astro.props;
---

<Base {title} {description} {keywords}>
  <div class="layout">

    <header class="header">
      <Navbar />
    </header>

    <main class="container">
      <div class="content">
        <slot />
      </div>

      {
        showSidebar && (
          <aside class="sidebar">
            <slot name="sidebar" />
          </aside>
        )
      }

    </main>

    <Footer />

  </div>
</Base>

<style lang="scss">
@use "tailwindcss";
.layout {
  @apply min-h-screen flex flex-col;
}

.container {
  width: var(--container);
  margin: 0 auto;
  @apply flex gap-10 py-8;
  view-transition-name: main;
}

.content {
  @apply flex-1;
}

.sidebar {
  @apply w-72 hidden xl:block shrink-0;
}
</style>