---
import Base from "./base.astro";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  showSidebar?: boolean;
}

const { title, description, keywords, showSidebar = true } = Astro.props;
---

<Base {title} {description} {keywords}>
  <div class="layout">
    <header class="header">
      <Navbar />
    </header>

    <main id="main-container">
      <div class="article-content">
        <slot />
      </div>
      {
        showSidebar && (
          <div class="sidebar-container">
            <slot name="sidebar" />
          </div>
        )
      }
    </main>

    <Footer />
  </div>
</Base>

<style lang="scss">
  
  .layout {
    @apply min-h-screen flex flex-col;
  }
  #main-container {
    width: var(--container);
    margin: 0 auto;
    @apply flex gap-10 py-8;
  }

  .article-content {
    @apply flex-1 min-w-0;
    view-transition-name: main;
  }

  .sidebar-container {
    @apply w-72 hidden xl:block shrink-0;
    background: rgba(0, 0, 0, 0);
  }
</style>
