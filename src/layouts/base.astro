---
// layouts/base.astro
import { siteConfig, profileConfig } from "@/config";
import "normalize.css";
import { THEME_DEFAULTS } from "@/constants/constants";
import type { THEME_MODE } from "@/constants/constants";
import { DEFAULT_SCHEMES } from "@/theme/default-schemes";
import { ClientRouter } from "astro:transitions";

export interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    themeMode?: THEME_MODE;
}

let {
    title,
    description = siteConfig.description,
    keywords = siteConfig.keywords,
    themeMode = siteConfig.themeMode,
} = Astro.props;

title = title ? title + " - " + siteConfig.title : siteConfig.title;

const schemesJSON = JSON.stringify(DEFAULT_SCHEMES);
---

<!doctype html>
<html lang={siteConfig.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content={profileConfig.name} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={siteConfig.url} />

        <link rel="sitemap" href="/sitemap.xml" />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Rss Feed"
            href="/rss.xml"
        />
        <title>{title}</title>

        <ClientRouter />

        <!-- 注入默认颜色表 -->
        <script is:inline define:vars={{ schemesJSON }}>
            window.__colorSchemes = JSON.parse(schemesJSON);
        </script>

        <!-- 主题初始化与全局 API -->
        <script is:inline>
            (function () {
                var STORAGE_KEY = "theme-mode";
                var SEED_KEY = "seed-color";

                function getStoredMode() {
                    try {
                        return localStorage.getItem(STORAGE_KEY);
                    } catch (e) {
                        return null;
                    }
                }

                function getSystemMode() {
                    if (
                        window.matchMedia &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                    ) {
                        return "dark";
                    }
                    return "light";
                }

                function applyTheme(mode, schemes) {
                    if (!schemes) schemes = window.__colorSchemes;
                    var scheme = schemes.light;
                    if (mode === "dark") scheme = schemes.dark;
                    else if (mode === "read") scheme = schemes.read;

                    var root = document.documentElement;
                    for (var key in scheme) {
                        root.style.setProperty(key, scheme[key]);
                    }
                    if (document.body) {
                        document.body.dataset.theme = mode;
                    }
                }

                window.__applyTheme = applyTheme;

                var systemQuery = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                );
                function systemListener(e) {
                    var stored = getStoredMode();
                    if (!stored || stored === "auto") {
                        applyTheme(e.matches ? "dark" : "light");
                    }
                }
                systemQuery.addEventListener("change", systemListener);

                var initialMode = getStoredMode() || "auto";
                if (initialMode === "auto") initialMode = getSystemMode();
                applyTheme(initialMode);
            })();
        </script>

        <style is:inline>
            body {
                background-color: var(--md-sys-color-background);
                color: var(--md-sys-color-on-background);
                margin: 0;
                min-height: 100vh;
                transition:
                    background-color 0.3s,
                    color 0.3s;
            }
            .container {
                max-width: 72rem;
                margin-left: auto;
                margin-right: auto;
                padding-left: 1rem;
                padding-right: 1rem;
                width: 100%;
                box-sizing: border-box;
            }
        </style>
    </head>
    <body>
        <slot name="head" />
        <div class="container" data-theme={themeMode}>
            <slot />
        </div>
        <slot name="footer" />
    </body>
</html>
