---
import { siteConfig, profileConfig } from "@/config";
import type { THEME_MODE } from "@/constants/constants";
import SpaRouter from "@/components/spa-router.astro";
import Seo from "@/components/seo.astro";
import SearchModal from "@/components/search-modal.astro";
import BackToTop from "@/components/back-to-top.astro";
import RestoreStyle from "@/components/restore-style.astro";
import CodeEnhancer from "@/components/code-enhancer.astro";
import Lightbox from "@/components/lightbox.astro";
import Tooltip from "@/components/tooltip.astro";
import Animations from "@/components/animations.astro";
import "katex/dist/katex.min.css";
import styleUrl from "@/styles/style.css?url";

export interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    themeMode?: THEME_MODE;
    ogType?: "website" | "article";
    ogImage?: string;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    author?: string;
}

const walineHost = (() => {
    try {
        return new URL(siteConfig.comments.walineServer).host;
    } catch {
        return "";
    }
})();

let {
    title,
    description = siteConfig.description,
    keywords = siteConfig.keywords,
    ogType = "website",
    ogImage = siteConfig.defaultCover,
    publishedTime,
    modifiedTime,
    tags,
    author = profileConfig.name,
} = Astro.props;

const fullTitle = title ? title + " - " + siteConfig.title : siteConfig.title;
---

<!doctype html>
<html lang={siteConfig.lang}>
    <head>
        <script is:inline>
            (function () {
                try {
                    var saved = localStorage.getItem("theme-mode") || "auto";
                    var dark =
                        saved === "dark" ||
                        (saved === "auto" &&
                            window.matchMedia("(prefers-color-scheme: dark)").matches);
                    var root = document.documentElement;
                    root.setAttribute("data-theme", dark ? "dark" : "light");
                    root.setAttribute("data-mode", saved);
                    root.classList.toggle("dark", dark);
                } catch (e) {}
            })();
        </script>

        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light dark" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />

        <link rel="preconnect" href="https://busuanzi.ibruce.info" crossorigin />
        {walineHost && <link rel="preconnect" href={`https://${walineHost}`} crossorigin />}

        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content={author} />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

        <Seo
            title={fullTitle}
            description={description}
            type={ogType}
            image={ogImage}
            url={Astro.url.pathname}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            tags={tags}
            author={author}
        />

        <link rel="sitemap" href="/sitemap.xml" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link
            rel="alternate"
            type="application/rss+xml"
            title="RSS Feed"
            href="/rss.xml"
        />

        <title>{fullTitle}</title>

        <link rel="stylesheet" href={styleUrl} data-permanent />

        <script is:inline defer src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    </head>

    <body>
        <a class="skip-link" href="#main-container">跳到主要内容</a>
        <SpaRouter
            contentSelector="#main-container"
            heroSelector="#hero-slot"
            scrollToTop={true}
            prefetch={false}
            ignoreHash={false}
            scrollBehavior="smooth"
        />
        <SearchModal />
        <RestoreStyle />
        <CodeEnhancer />
        <Lightbox />
        <slot />

        <BackToTop />
        <Tooltip />
        <Animations />

        <script is:inline>
          // 通用点击波纹扩散：为带 data-ripple 的元素在点击处生成扩散圆
          (function () {
            function spawnRipple(e) {
              var host = e.target && e.target.closest
                ? e.target.closest("[data-ripple]")
                : null;
              if (!host) return;
              var rect = host.getBoundingClientRect();
              var size = Math.max(rect.width, rect.height);
              var ink = document.createElement("span");
              ink.className = "ripple-ink";
              ink.style.width = ink.style.height = size + "px";
              ink.style.left = e.clientX - rect.left - size / 2 + "px";
              ink.style.top = e.clientY - rect.top - size / 2 + "px";
              host.appendChild(ink);
              ink.addEventListener("animationend", function () {
                ink.remove();
              });
            }
            document.addEventListener("pointerdown", spawnRipple);
          })();
        </script>
    </body>
</html>
