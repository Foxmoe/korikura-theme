---
// 评论区组件，使用 @waline/client，后端为独立部署的 Waline Worker。
import { siteConfig } from "../config";

const walineServer = siteConfig.comments?.walineServer ?? "https://waline.foxmoe.top";
---

<section class="comments" aria-label="评论">
  <h2 class="comments-title">评论</h2>
  <div id="waline"></div>
</section>

<link
  rel="stylesheet"
  href="https://unpkg.com/@waline/client@v3/dist/waline.css"
/>
<script is:inline src="https://unpkg.com/@waline/client@v3/dist/waline.umd.js"></script>

<script is:inline define:vars={{ walineServer }}>
  (function () {
    let walineInstance = null;

    function initWaline() {
      // Waline 脚本可能尚未加载完成，稍后重试
      if (typeof Waline === "undefined") {
        return setTimeout(initWaline, 50);
      }
      // 销毁旧实例，避免 SPA 切换时重复渲染
      if (walineInstance) {
        try {
          walineInstance.destroy();
        } catch (e) {
          /* 忽略已脱离 DOM 的实例销毁错误 */
        }
        walineInstance = null;
      }
      const el = document.querySelector("#waline");
      if (!el) return;
      el.innerHTML = "";
      walineInstance = Waline.init({
        el: "#waline",
        serverURL: walineServer,
        lang: "zh-CN",
        // 评论数统计等可按需开启
        visitor: false,
      });
    }

    // 首次加载
    initWaline();

    // SPA 页面切换后重跑
    window.addEventListener("spa-navigate", () => setTimeout(initWaline, 60));
  })();
</script>
