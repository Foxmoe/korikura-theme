---
import { siteConfig } from "@/config";

const env = siteConfig.comments?.twikooEnv || "";
const src =
  siteConfig.comments?.twikooSrc ||
  "https://cdn.jsdelivr.net/npm/twikoo@1.6.41/dist/twikoo.all.min.js";
---

<section class="twikoo-comments" aria-label="评论">
  <h2 class="comments-title">评论</h2>
  <div id="tcomment"></div>

  {
    !env && (
      <p class="comments-hint">
        评论功能需在 <code>src/config.ts</code> 的{" "}
        <code>comments.twikooEnv</code> 中填入 Twikoo 环境 ID 后启用。
      </p>
    )
  }
</section>

{
  env && (
    <script define:vars={{ env, src }}>
      (function () {
        // 仅当全局 twikoo 不存在时才动态加载一次脚本，避免 SPA 重复加载报 "Identifier 'e' has already been declared"
        function initTwikoo() {
          const el = document.getElementById("tcomment");
          if (
            window.twikoo &&
            window.twikoo.init &&
            el &&
            el.childElementCount === 0
          ) {
            window.twikoo.init({ envId: env, el: "#tcomment" });
          }
        }

        function waitTwikoo(cb, tries) {
          tries = tries || 0;
          if (window.twikoo && window.twikoo.init) return cb();
          if (tries > 60) return;
          setTimeout(function () {
            waitTwikoo(cb, tries + 1);
          }, 100);
        }

        function loadTwikoo(cb) {
          if (window.twikoo && window.twikoo.init) return cb();
          // 单例加载：整个会话只插入一次 twikoo 脚本，避免重复执行
          // 压缩脚本导致 "Identifier 'e' has already been declared"
          if (!window.__twikooPromise) {
            window.__twikooPromise = new Promise(function (resolve, reject) {
              if (document.querySelector('script[data-twikoo]')) {
                return resolve();
              }
              const s = document.createElement("script");
              s.src = src;
              s.setAttribute("data-twikoo", "");
              s.onload = resolve;
              s.onerror = function () {
                s.remove();
                reject();
              };
              document.head.appendChild(s);
            }).catch(function () {
              window.__twikooPromise = null;
            });
          }
          window.__twikooPromise.then(function () {
            if (window.twikoo && window.twikoo.init) cb();
            else waitTwikoo(cb);
          });
        }

        function ensure() {
          const el = document.getElementById("tcomment");
          if (!el) return; // 当前页无评论容器
          if (window.twikoo && window.twikoo.init) return initTwikoo();
          loadTwikoo(initTwikoo);
        }

        ensure();
      })();
    </script>
  )
}
