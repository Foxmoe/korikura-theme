---
import { siteConfig } from "@/config";

const env = siteConfig.comments?.twikooEnv || "";
const src =
  siteConfig.comments?.twikooSrc ||
  "https://cdn.jsdelivr.net/npm/twikoo@1.6.41/dist/twikoo.nocss.js";
const twikooCss = "/twikoo.css";
---

<section class="twikoo-comments" aria-label="评论">
  <h2 class="comments-title">评论</h2>
  <div id="tcomment"></div>

  {
    !env && (
      <p class="comments-hint">
        评论功能需在 <code>src/config.ts</code> 的{" "}
        <code>comments.twikooEnv</code> 中填入 Twikoo 环境 ID 后启用。
      </p>
    )
  }
</section>

{
  env && (
  <script define:vars={{ env, src, twikooCss }}>
    (function () {
      function loadTwikooCSS() {
        if (document.getElementById("__twikoo-css")) return;
        var link = document.createElement("link");
        link.id = "__twikoo-css";
        link.rel = "stylesheet";
        link.href = twikooCss;
        // 先用 print 媒体加载（不阻塞渲染），加载完成再切换为 all
        link.media = "print";
        link.onload = function () { link.media = "all"; };
        document.head.appendChild(link);
      }

      function initTwikoo() {
        const el = document.getElementById("tcomment");
        if (
          window.twikoo &&
          window.twikoo.init &&
          el &&
          el.childElementCount === 0
        ) {
          window.twikoo.init({ envId: env, el: "#tcomment" });
        }
      }

      function waitTwikoo(cb, tries) {
        tries = tries || 0;
        if (window.twikoo && window.twikoo.init) return cb();
        if (tries > 60) return;
        setTimeout(function () {
          waitTwikoo(cb, tries + 1);
        }, 100);
      }

      function loadTwikoo(cb) {
        if (window.twikoo && window.twikoo.init) return cb();
        if (document.querySelector('script[src="' + src + '"]')) {
          return waitTwikoo(cb);
        }
        if (window.__twikooLoading) return waitTwikoo(cb);
        window.__twikooLoading = true;
        var s = document.createElement("script");
        s.src = src;
        s.setAttribute("data-twikoo", "");
        s.onload = function () {
          window.__twikooLoading = false;
          cb();
        };
        s.onerror = function () {
          window.__twikooLoading = false;
        };
        document.head.appendChild(s);
      }

      function ensure() {
        const el = document.getElementById("tcomment");
        if (!el) return; // 当前页无评论容器

        // 评论区通常在首屏之外：临近视口时才以非阻塞方式加载样式，降低首屏加载量
        var section = el.closest(".twikoo-comments") || el;
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  loadTwikooCSS();
                  io.disconnect();
                }
              });
            },
            { rootMargin: "400px" }
          );
          io.observe(section);
        } else {
          loadTwikooCSS();
        }

        if (window.twikoo && window.twikoo.init) return initTwikoo();
        loadTwikoo(initTwikoo);
      }

      ensure();
    })();
  </script>
  )
}
