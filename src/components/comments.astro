---
import { siteConfig } from "../config";

const walineServer = siteConfig.comments?.walineServer ?? "https://waline.foxmoe.top";
---

<section class="comments" aria-label="评论">
  <h2 class="comments-title">评论</h2>
  <div id="waline"></div>
</section>

<style lang="scss" is:global>
  .comments {
    --waline-theme-color: var(--primary);
    --waline-active-color: var(--primary-hover);
    --waline-color: var(--text);
    --waline-bgcolor: var(--card-bg);
    --waline-bgcolor-light: color-mix(in oklab, var(--card-bg) 85%, var(--bg));
    --waline-bgcolor-sub: color-mix(in oklab, var(--card-bg) 68%, var(--bg));
    --waline-border-color: var(--border);
    --waline-disable-bgcolor: var(--border);
    --waline-disable-color: var(--muted);
    --waline-code-bgcolor: color-mix(in oklab, var(--primary) 12%, var(--card-bg));

    .wl-panel {
      font-family: var(--font-sans);
      background: var(--card-bg) !important;
      border: 1px solid var(--border) !important;
      border-radius: 0.75rem;
      box-shadow: 0 2px 12px color-mix(in oklab, #000 10%, transparent);
    }

    .wl-header {
      border-bottom-color: var(--border) !important;
    }
    .wl-header-item {
      background: transparent !important;
      color: var(--text) !important;
      border-color: var(--border) !important;
      border-radius: 0.5rem;
      &::placeholder { color: var(--muted) !important; }
      &:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent) !important;
      }
    }

    .wl-editor {
      background: color-mix(in oklab, var(--card-bg) 80%, var(--bg)) !important;
      color: var(--text) !important;
      border-color: var(--border) !important;
      border-radius: 0.6rem;
      transition: border-color 0.2s, box-shadow 0.2s;
      &:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent) !important;
      }
      &::placeholder { color: var(--muted) !important; }
    }

    .wl-action {
      background: transparent !important;
      border-top-color: var(--border) !important;
    }
    .wl-word-count { color: var(--muted) !important; }

    .wl-btn {
      border-radius: 0.6rem;
      transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    }
    .wl-btn-primary {
      background: color-mix(in oklab, var(--primary) 68%, #000) !important;
      border-color: color-mix(in oklab, var(--primary) 68%, #000) !important;
      color: #fff !important;
      &:hover {
        background: color-mix(in oklab, var(--primary) 58%, #000) !important;
        border-color: color-mix(in oklab, var(--primary) 58%, #000) !important;
      }
    }

    .wl-list {
      padding-top: 0.25rem;
    }
    .wl-card {
      border-radius: 0.65rem;
      transition: border-color 0.2s;
      &:hover {
        border-color: color-mix(in oklab, var(--primary) 30%, var(--border)) !important;
      }
    }
    .wl-nick { color: var(--text) !important; font-weight: 600; }
    .wl-time { color: var(--muted) !important; }
    .wl-content {
      color: var(--text) !important;
      p { margin-bottom: 0.4em; &:last-child { margin-bottom: 0; } }
    }
    .wl-content blockquote {
      border-left-color: var(--primary) !important;
      color: var(--muted) !important;
      background: color-mix(in oklab, var(--primary) 8%, transparent) !important;
    }
    .wl-content code:not(pre code) {
      @apply rounded px-1.5 py-0.5 text-[0.85em] font-medium;
      background: color-mix(in oklab, var(--primary) 12%, var(--card-bg)) !important;
      color: var(--primary) !important;
    }
    .wl-content pre {
      background: color-mix(in oklab, var(--bg) 70%, var(--card-bg)) !important;
      border: 1px solid var(--border) !important;
      border-radius: 0.5rem;
    }
    .wl-quote { color: var(--muted) !important; }
    .wl-quote .wl-nick { color: var(--primary-hover) !important; }

    .wl-avatar { border-radius: 9999px; }

    .wl-like {
      border-color: var(--border) !important;
      color: var(--muted) !important;
      transition: color 0.2s, border-color 0.2s;
      &:hover, &.active {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
      }
    }

    .wl-reply-form .wl-editor,
    .wl-reply-form .wl-input {
      background: var(--card-bg) !important;
      color: var(--text) !important;
      border-color: var(--border) !important;
      border-radius: 0.5rem;
    }

    .wl-more { color: var(--muted) !important; }
    .wl-more:hover { color: var(--primary) !important; }

    .wl-info { color: var(--muted) !important; }
    .wl-info a { color: var(--primary) !important; }

    .wl-admin-badge {
      background: var(--primary) !important;
      color: #fff !important;
    }

    .wl-gif-popup,
    .wl-image-popup {
      background: var(--card-bg) !important;
      border: 1px solid var(--border) !important;
      box-shadow: 0 4px 16px color-mix(in oklab, #000 14%, transparent);
    }
  }
</style>

<link
  rel="stylesheet"
  href="https://unpkg.com/@waline/client@v3/dist/waline.css"
/>
<script is:inline defer src="https://unpkg.com/@waline/client@v3/dist/waline.umd.js"></script>

<script is:inline define:vars={{ walineServer }}>
  (function () {
    let walineInstance = null;

    function initWaline() {
      if (typeof Waline === "undefined") {
        return setTimeout(initWaline, 50);
      }
      if (walineInstance) {
        try {
          walineInstance.destroy();
        } catch (e) {
        }
        walineInstance = null;
      }
      const el = document.querySelector("#waline");
      if (!el) return;
      el.innerHTML = "";
      walineInstance = Waline.init({
        el: "#waline",
        serverURL: walineServer,
        lang: "zh-CN",
        visitor: false,
      });
    }

    initWaline();

    window.addEventListener("spa-navigate", () => setTimeout(initWaline, 60));
  })();
</script>
