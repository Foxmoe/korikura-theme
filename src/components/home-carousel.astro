---
import { getPublishedPosts, getDynamics } from "@/utils/posts";
import Icon from "./icon.astro";

// 贡献日历：统计文章与动态的按日活跃度
const posts = await getPublishedPosts();
const dyns = await getDynamics();
const counts = new Map<string, number>();
const bump = (d: Date) => {
  const k = d.toISOString().slice(0, 10);
  counts.set(k, (counts.get(k) || 0) + 1);
};
posts.forEach((p) => bump(p.data.updatedDate ?? p.data.pubDate));
dyns.forEach((d) => bump(d.data.date));

const WEEKS = 26;
const today = new Date();
const startOfWeek = (date: Date) => {
  const d = new Date(date);
  const day = (d.getDay() + 6) % 7; // 周一=0
  d.setDate(d.getDate() - day);
  d.setHours(0, 0, 0, 0);
  return d;
};
const gridStart = startOfWeek(today);
gridStart.setDate(gridStart.getDate() - (WEEKS - 1) * 7);

let max = 1;
counts.forEach((v) => (max = Math.max(max, v)));

const weeks: { date: string; count: number; level: number }[][] = [];
for (let w = 0; w < WEEKS; w++) {
  const col: { date: string; count: number; level: number }[] = [];
  for (let day = 0; day < 7; day++) {
    const d = new Date(gridStart);
    d.setDate(gridStart.getDate() + w * 7 + day);
    const key = d.toISOString().slice(0, 10);
    const c = counts.get(key) || 0;
    const level = c === 0 ? 0 : Math.min(4, Math.ceil((c / max) * 4));
    col.push({ date: key, count: c, level });
  }
  weeks.push(col);
}
const totalContrib = posts.length + dyns.length;

const siteMessages = [
  { icon: "star", text: "本站已接入不蒜子访问统计" },
  { icon: "folder", text: "文章分类系统已上线" },
  { icon: "message", text: "动态支持朋友圈九宫格与灯箱" },
  { icon: "sun", text: "全新樱花粉主题已启用" },
];
---

<div class="hc" id="home-carousel">
  <div class="hc-panels">
    <!-- 天气 -->
    <div class="hc-panel" data-panel="weather">
      <div class="hc-panel-head">
        <Icon name="sun" size={15} /> 今日天气
      </div>
      <div class="hc-weather" id="hc-weather">
        <div class="hc-w-loading">加载中…</div>
      </div>
    </div>

    <!-- 一言 -->
    <div class="hc-panel" data-panel="hitokoto">
      <div class="hc-panel-head">
        <Icon name="message" size={15} /> 一言
      </div>
      <blockquote class="hc-hitokoto" id="hc-hitokoto">
        生活不止眼前的苟且，还有诗和远方。
      </blockquote>
      <div class="hc-hitokoto-from" id="hc-hitokoto-from"></div>
    </div>

    <!-- 更新日历 -->
    <div class="hc-panel" data-panel="calendar">
      <div class="hc-panel-head">
        <Icon name="calendar" size={15} /> 更新日历
      </div>
      <div class="hc-cal">
        <div class="hc-cal-grid">
          {
            weeks.map((col) => (
              <div class="hc-cal-col">
                {col.map((cell) => (
                  <span
                    class={`hc-cell lv-${cell.level}`}
                    title={`${cell.date}：${cell.count} 次更新`}
                  />
                ))}
              </div>
            ))
          }
        </div>
        <div class="hc-cal-legend">
          <span>少</span>
          {[0, 1, 2, 3, 4].map((l) => <span class={`hc-cell lv-${l}`} />)}
          <span>多</span>
        </div>
        <div class="hc-cal-total">近半年共 {totalContrib} 次更新</div>
      </div>
    </div>

    <!-- 全站消息 -->
    <div class="hc-panel" data-panel="messages">
      <div class="hc-panel-head">
        <Icon name="info" size={15} /> 全站消息
      </div>
      <ul class="hc-msg-list">
        {
          siteMessages.map((m) => (
            <li class="hc-msg">
              <Icon name={m.icon} size={15} />
              <span>{m.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="hc-dots" id="hc-dots">
    <button type="button" class="hc-dot active" data-i="0" aria-label="天气" data-tooltip="天气" />
    <button type="button" class="hc-dot" data-i="1" aria-label="一言" data-tooltip="一言" />
    <button type="button" class="hc-dot" data-i="2" aria-label="更新日历" data-tooltip="更新日历" />
    <button type="button" class="hc-dot" data-i="3" aria-label="全站消息" data-tooltip="全站消息" />
  </div>
</div>

<style lang="scss">
  .hc {
    @apply relative rounded-xl border border-[var(--border)]
           bg-[var(--card-bg)]/60 overflow-hidden min-h-[320px];
    box-shadow: 0 4px 18px -14px rgba(0, 0, 0, 0.28);
  }
  .hc-panels {
    @apply relative;
    min-height: 320px;
  }
  .hc-panel {
    @apply absolute inset-0 p-5 pb-9 flex flex-col gap-3
           opacity-0 pointer-events-none transition-opacity duration-500;
    &.active {
      @apply opacity-100 pointer-events-auto;
    }
  }
  .hc-panel-head {
    @apply flex items-center gap-1.5 text-sm font-semibold text-[var(--primary)];
  }
  .hc-weather {
    @apply flex-1 flex items-center justify-center;
  }
  .hc-w-loading {
    @apply text-sm text-[var(--muted)];
  }
  .hc-w-card {
    @apply flex items-center gap-4 text-[var(--text)];
  }
  .hc-w-emoji {
    @apply text-5xl leading-none;
  }
  .hc-w-temp {
    @apply text-3xl font-bold;
  }
  .hc-w-meta {
    @apply text-sm text-[var(--muted)] mt-0.5;
  }
  .hc-hitokoto {
    @apply flex-1 flex items-center text-lg leading-relaxed text-[var(--text)]
           border-l-2 border-[var(--primary)] pl-4 my-0 italic;
  }
  .hc-hitokoto-from {
    @apply text-sm text-[var(--muted)] text-right;
  }
  .hc-cal {
    @apply flex flex-col gap-2 rounded-lg p-3
           bg-[var(--bg)]/40 border border-[var(--border)];
  }
  .hc-cal-grid {
    @apply flex gap-1 overflow-x-auto pb-1;
  }
  .hc-cal-col {
    @apply flex flex-col gap-1;
  }
  .hc-cell {
    @apply w-[10px] h-[10px] rounded-[3px] bg-[var(--border)] transition-colors;
    &.lv-1 { background: color-mix(in oklab, var(--primary) 30%, var(--card-bg)); }
    &.lv-2 { background: color-mix(in oklab, var(--primary) 52%, var(--card-bg)); }
    &.lv-3 { background: color-mix(in oklab, var(--primary) 74%, var(--card-bg)); }
    &.lv-4 { background: var(--primary); }
  }
  .hc-cal-legend {
    @apply flex items-center gap-1.5 text-[10px] text-[var(--muted)];
  }
  .hc-cal-legend .hc-cell {
    @apply w-2.5 h-2.5 rounded-[2px];
  }
  .hc-cal-total {
    @apply text-xs text-[var(--muted)];
  }
  .hc-msg-list {
    @apply list-none p-0 m-0 flex flex-col gap-2 flex-1 justify-center;
  }
  .hc-msg {
    @apply flex items-center gap-2 text-sm text-[var(--text)]
           bg-[var(--primary)]/6 rounded-lg px-3 py-2;
    :global(svg) {
      @apply text-[var(--primary)] shrink-0;
    }
  }
  .hc-dots {
    @apply absolute bottom-3 left-1/2 -translate-x-1/2 flex flex-row gap-2 z-10;
  }
  .hc-dot {
    @apply w-2.5 h-2.5 rounded-full border-0 cursor-pointer p-0
           bg-[var(--muted)]/40 transition-all duration-200;
    &:hover {
      @apply bg-[var(--muted)];
    }
    &.active {
      @apply bg-[var(--primary)] scale-125;
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent);
    }
  }
</style>

<script>
  function initHomeCarousel() {
    const root = document.getElementById("home-carousel");
    if (!root) return;
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".hc-panel"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".hc-dot"));
    if (!panels.length) return;
    let idx = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      idx = (i + panels.length) % panels.length;
      panels.forEach((p, k) => p.classList.toggle("active", k === idx));
      dots.forEach((d, k) => d.classList.toggle("active", k === idx));
    };
    const start = () => {
      stop();
      timer = window.setInterval(() => show(idx + 1), 5000);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
    };

    dots.forEach((d) =>
      d.addEventListener("click", () => {
        show(Number(d.dataset.i) || 0);
        start();
      }),
    );
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    // 天气（open-meteo，默认北京；失败有兜底）
    const wBox = document.getElementById("hc-weather");
    const drawWeather = (emoji: string, temp: string, meta: string) => {
      if (!wBox) return;
      wBox.innerHTML = `<div class="hc-w-card"><div class="hc-w-emoji">${emoji}</div><div><div class="hc-w-temp">${temp}</div><div class="hc-w-meta">${meta}</div></div></div>`;
    };
    const wmap: Record<number, [string, string]> = {
      0: ["☀️", "晴"], 1: ["🌤️", "晴间多云"], 2: ["⛅", "多云"], 3: ["☁️", "阴"],
      45: ["🌫️", "雾"], 48: ["🌫️", "雾凇"], 51: ["🌦️", "小毛毛雨"], 53: ["🌦️", "毛毛雨"],
      55: ["🌧️", "毛毛雨"], 61: ["🌧️", "小雨"], 63: ["🌧️", "中雨"], 65: ["🌧️", "大雨"],
      71: ["🌨️", "小雪"], 73: ["❄️", "中雪"], 75: ["❄️", "大雪"], 80: ["🌦️", "阵雨"],
      81: ["🌦️", "阵雨"], 82: ["⛈️", "强阵雨"], 85: ["🌨️", "阵雪"], 86: ["🌨️", "阵雪"],
      95: ["⛈️", "雷阵雨"], 96: ["⛈️", "雷阵雨伴雹"], 99: ["⛈️", "强雷暴"],
    };
    fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=39.9042&longitude=116.4074&current_weather=true",
    )
      .then((r) => r.json())
      .then((j) => {
        const w = j.current_weather;
        if (!w) throw new Error("no weather");
        const [emoji, desc] = wmap[w.weathercode] || ["🌡️", "未知"];
        drawWeather(emoji, `${Math.round(w.temperature)}°C`, `北京 · ${desc}`);
      })
      .catch(() => drawWeather("🌤️", "23°C", "北京 · 多云"));

    // 一言（hitokoto）
    const hk = document.getElementById("hc-hitokoto");
    const hkFrom = document.getElementById("hc-hitokoto-from");
    fetch("https://v1.hitokoto.cn/?c=f&encode=json")
      .then((r) => r.json())
      .then((j) => {
        if (hk && j.hitokoto) hk.textContent = j.hitokoto;
        if (hkFrom && j.from) hkFrom.textContent = `—— ${j.from}`;
      })
      .catch(() => {});

    show(0);
    start();
  }

  initHomeCarousel();
  window.addEventListener("spa-navigate", () => setTimeout(initHomeCarousel, 60));
</script>
