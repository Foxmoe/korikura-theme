---
import { getPublishedPosts, getDynamics } from "@/utils/posts";
import Icon from "./icon.astro";

const posts = await getPublishedPosts();
const dyns = await getDynamics();
const counts = new Map<string, number>();
const bump = (d: Date) => {
  const k = d.toISOString().slice(0, 10);
  counts.set(k, (counts.get(k) || 0) + 1);
};
posts.forEach((p) => bump(p.data.updatedDate ?? p.data.pubDate));
dyns.forEach((d) => bump(d.data.date));

const WEEKS = 26;
const today = new Date();
const startOfWeek = (date: Date) => {
  const d = new Date(date);
  const day = (d.getDay() + 6) % 7;
  d.setDate(d.getDate() - day);
  d.setHours(0, 0, 0, 0);
  return d;
};
const gridStart = startOfWeek(today);
gridStart.setDate(gridStart.getDate() - (WEEKS - 1) * 7);

let max = 1;
counts.forEach((v) => (max = Math.max(max, v)));

const weeks: { date: string; count: number; level: number }[][] = [];
for (let w = 0; w < WEEKS; w++) {
  const col: { date: string; count: number; level: number }[] = [];
  for (let day = 0; day < 7; day++) {
    const d = new Date(gridStart);
    d.setDate(gridStart.getDate() + w * 7 + day);
    const key = d.toISOString().slice(0, 10);
    const c = counts.get(key) || 0;
    const level = c === 0 ? 0 : Math.min(4, Math.ceil((c / max) * 4));
    col.push({ date: key, count: c, level });
  }
  weeks.push(col);
}
const totalContrib = posts.length + dyns.length;

const siteMessages = [
  { icon: "star", text: "本站已接入不蒜子访问统计" },
  { icon: "folder", text: "文章分类系统已上线" },
  { icon: "message", text: "动态支持朋友圈九宫格与灯箱" },
  { icon: "sun", text: "全新樱花粉主题已启用" },
];
---

<div class="hc" id="home-carousel">
  <div class="hc-panels">
    <div class="hc-panel hc-weather-panel" data-panel="weather">
      <div class="hc-weather" id="hc-weather">
        <div class="hc-w-loading">加载中…</div>
      </div>
    </div>

    <div class="hc-panel" data-panel="hitokoto">
      <div class="hc-panel-head">
        <Icon name="message" size={18} /> 一言
      </div>
      <blockquote class="hc-hitokoto" id="hc-hitokoto">
        生活不止眼前的苟且，还有诗和远方。
      </blockquote>
      <div class="hc-hitokoto-from" id="hc-hitokoto-from"></div>
    </div>

    <div class="hc-panel hc-cal-panel" data-panel="calendar">
      <div class="hc-cal">
        <div class="hc-cal-top">
          <div class="hc-cal-title">
            <Icon name="calendar" size={18} /> 更新日历
          </div>
          <div class="hc-cal-total">近半年共 {totalContrib} 次更新</div>
        </div>
        <div class="hc-cal-grid">
          {
            weeks.map((col) => (
              <div class="hc-cal-col">
                {col.map((cell) => (
                  <span
                    class={`hc-cell lv-${cell.level}`}
                    title={`${cell.date}：${cell.count} 次更新`}
                  />
                ))}
              </div>
            ))
          }
        </div>
        <div class="hc-cal-legend">
          <span>少</span>
          {[0, 1, 2, 3, 4].map((l) => <span class={`hc-cell lv-${l}`} />)}
          <span>多</span>
        </div>
      </div>
    </div>

    <div class="hc-panel" data-panel="messages">
      <div class="hc-panel-head">
        <Icon name="info" size={18} /> 全站消息
      </div>
      <ul class="hc-msg-list">
        {
          siteMessages.map((m) => (
            <li class="hc-msg">
              <Icon name={m.icon} size={18} />
              <span>{m.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="hc-dots" id="hc-dots">
    <button type="button" class="hc-dot active" data-i="0" aria-label="天气" data-tooltip="天气" />
    <button type="button" class="hc-dot" data-i="1" aria-label="一言" data-tooltip="一言" />
    <button type="button" class="hc-dot" data-i="2" aria-label="更新日历" data-tooltip="更新日历" />
    <button type="button" class="hc-dot" data-i="3" aria-label="全站消息" data-tooltip="全站消息" />
  </div>
</div>

<style lang="scss">
  .hc {
    @apply relative rounded-xl border border-(--border)
           bg-(--card-bg) overflow-hidden min-h-[260px];
    box-shadow: 0 2px 10px -8px rgba(0, 0, 0, 0.22);
  }
  .hc-panels {
    @apply relative;
    min-height: 260px;
  }
  .hc-panel {
    @apply absolute inset-0 p-4 pb-8 flex flex-col gap-2
           opacity-0 pointer-events-none transition-opacity duration-500;
    &.active {
      @apply opacity-100 pointer-events-auto;
    }
  }
  .hc-panel-head {
    @apply flex items-center gap-1.5 text-xl font-bold text-(--text) relative pl-3 mb-2;
    &::before {
      content: "";
      @apply absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5 rounded-full bg-(--primary);
    }
  }
  .hc-weather-panel {
    @apply p-0;
  }
  .hc-weather {
    @apply w-full h-full;
  }
  .hc-w-loading {
    @apply text-sm text-(--muted) flex items-center justify-center h-full;
  }
  :global(.hc-w-hero) {
    @apply relative w-full h-full overflow-hidden flex flex-col
           text-white px-5 pt-4 pb-9 justify-between;
    border-radius: inherit;
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.45);
    animation: hc-w-in 0.5s ease both;
  }
  @keyframes hc-w-in {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }
  :global(.hc-w-glow) {
    @apply absolute w-56 h-56 rounded-full pointer-events-none;
    top: -22%;
    right: -18%;
    background: rgba(255, 255, 255, 0.18);
    filter: blur(6px);
  }
  :global(.hc-w-glow2) {
    @apply absolute w-40 h-40 rounded-full pointer-events-none;
    bottom: -16%;
    left: -12%;
    background: rgba(255, 255, 255, 0.1);
    filter: blur(8px);
  }
  :global(.hc-w-label) {
    @apply text-sm font-medium opacity-90 relative z-10;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  :global(.hc-w-main) {
    @apply flex items-center gap-3 relative z-10 mt-auto;
  }
  :global(.hc-w-icon) {
    @apply text-[3.5rem] leading-none drop-shadow;
  }
  :global(.hc-w-temp) {
    @apply text-6xl font-bold leading-none drop-shadow-md;
  }
  :global(.hc-w-cond) {
    @apply flex items-center gap-3 relative z-10 mt-2 text-sm;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  :global(.hc-w-desc) {
    @apply font-semibold;
  }
  :global(.hc-w-sub) {
    @apply opacity-85;
  }

  :global(.hc-w-hero[data-w="clear"]) {
    background: linear-gradient(150deg, #2193b0 0%, #6dd5ed 100%);
  }
  :global(.hc-w-hero[data-w="partly"]) {
    background: linear-gradient(150deg, #4b6cb7 0%, #9aa7b1 100%);
  }
  :global(.hc-w-hero[data-w="cloudy"]) {
    background: linear-gradient(150deg, #536976 0%, #292e49 100%);
  }
  :global(.hc-w-hero[data-w="fog"]) {
    background: linear-gradient(150deg, #5c6e7a 0%, #9aa7b1 100%);
  }
  :global(.hc-w-hero[data-w="rain"]) {
    background: linear-gradient(150deg, #2c3e50 0%, #4ca1af 100%);
  }
  :global(.hc-w-hero[data-w="snow"]) {
    background: linear-gradient(150deg, #4b79a1 0%, #283e51 100%);
  }
  :global(.hc-w-hero[data-w="storm"]) {
    background: linear-gradient(150deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  }
  .hc-hitokoto {
    @apply flex-1 flex items-center text-base leading-relaxed text-(--text)
           border-l-2 border-(--primary) pl-4 my-0 italic;
  }
  .hc-hitokoto-from {
    @apply text-sm text-(--muted) text-right;
  }
  .hc-cal-panel {
    @apply p-0;
  }
  .hc-cal {
    @apply w-full h-full flex flex-col gap-3 p-4 rounded-[14px];
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--primary) 8%, var(--card-bg)),
      var(--card-bg)
    );
  }
  .hc-cal-top {
    @apply flex items-center justify-between gap-2;
  }
  .hc-cal-title {
    @apply flex items-center gap-1.5 text-base font-bold text-(--text) relative pl-3;
    &::before {
      content: "";
      @apply absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5 rounded-full bg-(--primary);
    }
    :global(svg) {
      @apply text-(--primary);
    }
  }
  .hc-cal-grid {
    @apply flex gap-1 overflow-x-auto pb-1;
  }
  .hc-cal-col {
    @apply flex flex-col gap-1;
  }
  .hc-cell {
    @apply w-[10px] h-[10px] rounded-[3px] bg-(--border) transition-colors;
    &.lv-1 { background: color-mix(in oklab, var(--primary) 30%, var(--card-bg)); }
    &.lv-2 { background: color-mix(in oklab, var(--primary) 52%, var(--card-bg)); }
    &.lv-3 { background: color-mix(in oklab, var(--primary) 74%, var(--card-bg)); }
    &.lv-4 { background: var(--primary); }
  }
  .hc-cal-legend {
    @apply flex items-center gap-1.5 text-[10px] text-(--muted);
  }
  .hc-cal-legend .hc-cell {
    @apply w-2.5 h-2.5 rounded-[2px];
  }
  .hc-cal-total {
    @apply text-xs text-(--muted) shrink-0;
  }
  .hc-msg-list {
    @apply list-none p-0 m-0 flex flex-col gap-2 flex-1 justify-center;
  }
  .hc-msg {
    @apply flex items-center gap-2 text-sm text-(--text)
           bg-(--primary)/6 rounded-lg px-3 py-2;
    :global(svg) {
      @apply text-(--primary) shrink-0;
    }
  }
  .hc-dots {
    @apply absolute bottom-3 left-1/2 -translate-x-1/2 flex flex-row gap-2 z-10;
  }
  .hc-dot {
    @apply w-2.5 h-2.5 rounded-full border-0 cursor-pointer p-0
           bg-(--muted)/40 transition-all duration-200;
    &:hover {
      @apply bg-(--muted);
    }
    &.active {
      @apply bg-(--primary) scale-125;
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 22%, transparent);
    }
  }
</style>

<script>
  function initHomeCarousel() {
    const root = document.getElementById("home-carousel");
    if (!root) return;
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".hc-panel"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".hc-dot"));
    if (!panels.length) return;
    let idx = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      idx = (i + panels.length) % panels.length;
      panels.forEach((p, k) => p.classList.toggle("active", k === idx));
      dots.forEach((d, k) => d.classList.toggle("active", k === idx));
    };
    const start = () => {
      stop();
      timer = window.setInterval(() => show(idx + 1), 5000);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
    };

    dots.forEach((d) =>
      d.addEventListener("click", () => {
        show(Number(d.dataset.i) || 0);
        start();
      }),
    );
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);

    const wBox = document.getElementById("hc-weather");
    const drawWeather = (
      theme: string,
      emoji: string,
      temp: string,
      location: string,
      desc: string,
      sub = "",
    ) => {
      if (!wBox) return;
      wBox.innerHTML = `<div class="hc-w-hero" data-w="${theme}">
        <div class="hc-w-glow"></div>
        <div class="hc-w-glow2"></div>
        <div class="hc-w-label">📍 ${location} · 今日天气</div>
        <div class="hc-w-main">
          <div class="hc-w-icon">${emoji}</div>
          <div class="hc-w-temp">${temp}</div>
        </div>
        <div class="hc-w-cond">
          <span class="hc-w-desc">${desc}</span>
          ${sub ? `<span class="hc-w-sub">${sub}</span>` : ""}
        </div>
      </div>`;
    };
    const wmap: Record<number, [string, string]> = {
      0: ["☀️", "晴"], 1: ["🌤️", "晴间多云"], 2: ["⛅", "多云"], 3: ["☁️", "阴"],
      45: ["🌫️", "雾"], 48: ["🌫️", "雾凇"], 51: ["🌦️", "小毛毛雨"], 53: ["🌦️", "毛毛雨"],
      55: ["🌧️", "毛毛雨"], 61: ["🌧️", "小雨"], 63: ["🌧️", "中雨"], 65: ["🌧️", "大雨"],
      71: ["🌨️", "小雪"], 73: ["❄️", "中雪"], 75: ["❄️", "大雪"], 80: ["🌦️", "阵雨"],
      81: ["🌦️", "阵雨"], 82: ["⛈️", "强阵雨"], 85: ["🌨️", "阵雪"], 86: ["🌨️", "阵雪"],
      95: ["⛈️", "雷阵雨"], 96: ["⛈️", "雷阵雨伴雹"], 99: ["⛈️", "强雷暴"],
    };
    const themeOf = (code: number): string => {
      if (code === 0) return "clear";
      if (code === 1 || code === 2) return "partly";
      if (code === 3) return "cloudy";
      if (code === 45 || code === 48) return "fog";
      if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return "rain";
      if ([71, 73, 75, 85, 86].includes(code)) return "snow";
      if ([95, 96, 99].includes(code)) return "storm";
      return "cloudy";
    };
    const drawFrom = (w: { weathercode: number; temperature: number; windspeed: number }) => {
      const [emoji, desc] = wmap[w.weathercode] || ["🌡️", "未知"];
      drawWeather(
        themeOf(w.weathercode),
        emoji,
        `${Math.round(w.temperature)}°C`,
        "北京",
        desc,
        `风速 ${Math.round(w.windspeed)} km/h`,
      );
    };
    fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=39.9042&longitude=116.4074&current_weather=true",
    )
      .then((r) => r.json())
      .then((j) => {
        const w = j.current_weather;
        if (!w) throw new Error("no weather");
        drawFrom(w);
      })
      .catch(() => drawFrom({ weathercode: 2, temperature: 23, windspeed: 8 }));

    const hk = document.getElementById("hc-hitokoto");
    const hkFrom = document.getElementById("hc-hitokoto-from");
    fetch("https://v1.hitokoto.cn/?c=f&encode=json")
      .then((r) => r.json())
      .then((j) => {
        if (hk && j.hitokoto) hk.textContent = j.hitokoto;
        if (hkFrom && j.from) hkFrom.textContent = `—— ${j.from}`;
      })
      .catch(() => {});

    show(0);
    start();
  }

  initHomeCarousel();
  window.addEventListener("spa-navigate", () => setTimeout(initHomeCarousel, 60));
</script>
