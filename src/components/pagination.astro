---
interface Props {
  currentPage: number;
  totalPages: number;
}
const { currentPage, totalPages } = Astro.props;

function pageUrl(p: number) {
  return p <= 1 ? "/posts" : `/posts/page/${p}`;
}

function pageItems(): (number | "...")[] {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const items: (number | "...")[] = [1];
  const start = Math.max(2, currentPage - 1);
  const end = Math.min(totalPages - 1, currentPage + 1);
  if (start > 2) items.push("...");
  for (let i = start; i <= end; i++) items.push(i);
  if (end < totalPages - 1) items.push("...");
  items.push(totalPages);
  return items;
}
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="分页">
      {currentPage > 1 && (
        <a href={pageUrl(currentPage - 1)} class="page-btn">
          ← 上一页
        </a>
      )}

      <div class="page-numbers">
        {pageItems().map((item) =>
          item === "..." ? (
            <span class="page-ellipsis">…</span>
          ) : (
            <a
              href={pageUrl(item)}
              class={`page-number ${item === currentPage ? "active" : ""}`}
              aria-current={item === currentPage ? "page" : undefined}
            >
              {item}
            </a>
          )
        )}
      </div>

      {currentPage < totalPages && (
        <a href={pageUrl(currentPage + 1)} class="page-btn">
          下一页 →
        </a>
      )}
    </nav>
  )
}

<style lang="scss">
  .pagination {
    @apply flex flex-wrap justify-center items-center gap-3 mt-12 pt-8 border-t border-(--border);
  }
  .page-btn {
    @apply px-4 py-2 rounded-lg text-sm font-medium
           text-(--text) border border-(--border)
           bg-(--card-bg) transition hover:border-(--primary) hover:text-(--primary);
  }
  .page-numbers {
    @apply flex items-center gap-1.5;
  }
  .page-number {
    @apply w-9 h-9 flex items-center justify-center rounded-lg text-sm
           font-medium text-(--muted) no-underline
           border border-transparent transition;
    &:hover {
      @apply bg-(--primary)/10 text-(--primary);
    }
    &.active {
      @apply bg-(--primary) text-white border-(--primary);
    }
  }
  .page-ellipsis {
    @apply px-1 text-(--muted);
  }
</style>
