---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = '' } = Astro.props;

function getPageUrl(page: number) {
  const params = new URLSearchParams();
  params.set('page', String(page));
  return `${baseUrl}?${params.toString()}`;
}
---

{totalPages > 1 && (
  <nav class="pagination">
    {currentPage > 1 && (
      <a href={getPageUrl(currentPage - 1)} class="page-btn">
        ← 上一页
      </a>
    )}

    <div class="page-numbers">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={getPageUrl(page)}
          class={`page-number ${page === currentPage ? 'active' : ''}`}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {page}
        </a>
      ))}
    </div>

    {currentPage < totalPages && (
      <a href={getPageUrl(currentPage + 1)} class="page-btn">
        下一页 →
      </a>
    )}
  </nav>
)}

<style lang="scss">
  .pagination {
    @apply flex flex-wrap justify-center items-center gap-3 mt-12 pt-8 border-t border-gray-100;
  }

  .page-btn {
    @apply px-4 py-2 rounded-lg text-sm font-medium text-gray-600 
           bg-gray-50 hover:bg-gray-100 transition-colors no-underline;
  }

  .page-numbers {
    @apply flex items-center gap-2;
  }

  .page-number {
    @apply w-10 h-10 flex items-center justify-center rounded-lg text-sm 
           font-medium text-gray-600 hover:bg-gray-100 transition-colors no-underline;
    
    &.active {
      @apply bg-gray-900 text-white hover:bg-gray-800;
    }
  }
</style>