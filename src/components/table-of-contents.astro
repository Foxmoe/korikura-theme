---
import Icon from "./icon.astro";

interface TocItem {
  depth: number;
  slug: string;
  text: string;
  subheadings: TocItem[];
}

const { headings = [] } = Astro.props as { headings?: any[] };

function generateToc(items: any[]): TocItem[] {
  const body = items.filter((h) => h.depth > 1);
  const toc: TocItem[] = [];
  body.forEach((h) => {
    const heading: TocItem = { ...h, subheadings: [] };
    if (heading.depth === 2 || toc.length === 0) {
      toc.push(heading);
      return;
    }
    const gap = heading.depth - toc[toc.length - 1].depth;
    let target = toc[toc.length - 1];
    for (let i = 1; i < gap; i++) {
      const subs = target.subheadings;
      if (!subs.length) break;
      target = subs[subs.length - 1];
    }
    target.subheadings.push(heading);
  });
  return toc;
}

const toc = generateToc(headings);
---

<div class="card toc" id="toc" style={toc.length ? "" : "display:none"}>
  <div class="toc-head">
    <Icon name="hash" size={15} />
    <span>目录</span>
    <button
      class="toc-toggle"
      id="toc-toggle"
      type="button"
      aria-label="折叠目录"
      aria-expanded="true"
    >
      <Icon name="chevron" size={14} class="toc-toggle-icon" />
    </button>
    <span class="toc-progress-track" title="阅读进度">
      <span class="toc-progress-bar" id="toc-progress"></span>
    </span>
  </div>
  <nav class="toc-body" id="toc-body" aria-label="文章目录">
    <ol class="toc-list">
      {
        toc.map((item) => (
          <li class="toc-item">
            <a
              class={`toc-link node-name--H${item.depth}`}
              href={`#${item.slug}`}
              data-target={item.slug}
            >{item.text}</a>
            {
              item.subheadings && item.subheadings.length > 0 && (
                <ol class="toc-list">
                  {item.subheadings.map((sub) => (
                    <li class="toc-item">
                      <a
                        class={`toc-link node-name--H${sub.depth}`}
                        href={`#${sub.slug}`}
                        data-target={sub.slug}
                      >{sub.text}</a>
                    </li>
                  ))}
                </ol>
              )
            }
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<style lang="scss">
  .toc-head {
    @apply flex items-center gap-1.5 text-sm font-semibold mb-3 text-(--primary);
  }
  .toc-toggle {
    @apply flex items-center justify-center w-6 h-6 rounded
           text-(--muted) bg-transparent border-0 cursor-pointer
           transition hover:text-(--primary) hover:bg-(--primary)/10 active:scale-95;
  }
  .toc-toggle-icon {
    @apply transition-transform duration-200;
  }
  .toc.is-collapsed .toc-toggle-icon {
    @apply -rotate-90;
  }
  .toc.is-collapsed .toc-body {
    @apply hidden;
  }
  .toc-progress-track {
    @apply ml-auto w-16 h-1 rounded-full overflow-hidden bg-(--border)/60;
  }
  .toc-progress-bar {
    @apply block h-full w-0 rounded-full bg-(--primary);
    transition: width 0.15s linear;
  }
  .toc-body {
    @apply text-sm relative;
  }
  .toc-body .toc-list {
    @apply list-none m-0 p-0 relative;
  }
  .toc-body .toc-list .toc-list {
    @apply ml-3.5 mt-0.5;
  }
  .toc-body .toc-link {
    @apply relative block py-1 pl-[20px] -ml-px text-(--muted) no-underline
           rounded-md transition-colors duration-200 cursor-pointer
           hover:text-(--primary) hover:bg-(--primary)/5;
  }
  .toc-body .toc-link::after {
    content: "";
    @apply absolute left-[5px] top-1/2 -translate-y-1/2 w-[3px] h-3.5 rounded-full
           bg-(--border) transition-all duration-200;
    z-index: 1;
  }
  .toc-body .toc-link.node-name--H2 {
    @apply text-[0.9rem];
  }
  .toc-body .toc-link.node-name--H3 {
    @apply text-[0.85rem];
  }
  .toc-body .toc-link.node-name--H4 {
    @apply text-[0.8rem];
  }
  .toc-body .toc-link.is-active {
    @apply text-(--primary) font-semibold bg-(--primary)/9;
  }
  .toc-body .toc-link.is-active::after {
    @apply bg-(--primary) h-5;
  }
  .toc-body .is-collapsed > .toc-list {
    @apply hidden;
  }
</style>

<script>
  function initToc() {
    const tocRoot = document.getElementById("toc");
    const tocBody = document.getElementById("toc-body");
    const toggle = document.getElementById("toc-toggle");
    const progress = document.getElementById("toc-progress");
    const content = document.querySelector("#main-container .prose");
    if (!tocBody) return;

    const links = Array.from(
      tocBody.querySelectorAll<HTMLAnchorElement>(".toc-link"),
    );
    const map: Record<string, HTMLAnchorElement> = {};
    links.forEach((l) => {
      const id = l.dataset.target;
      if (id) map[id] = l;
    });

    toggle?.addEventListener("click", () => {
      if (!tocRoot) return;
      const collapsed = tocRoot.classList.toggle("is-collapsed");
      toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
      toggle.setAttribute("aria-label", collapsed ? "展开目录" : "折叠目录");
    });

    links.forEach((a) => {
      const li = a.parentElement;
      if (li && li.querySelector(":scope > .toc-list")) {
        a.setAttribute("aria-expanded", "true");
      }
    });
    tocBody.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement)?.closest?.(".toc-link") as
        | HTMLAnchorElement
        | null;
      if (!a) return;
      const li = a.parentElement;
      if (li && li.querySelector(":scope > .toc-list")) {
        e.preventDefault();
        const collapsed = li.classList.toggle("is-collapsed");
        a.setAttribute("aria-expanded", collapsed ? "false" : "true");
      }
    });

    const headingEls = content
      ? Array.from(content.querySelectorAll<HTMLElement>("h1, h2, h3, h4"))
      : [];
    if (!headingEls.length) return;

    let activeId: string | null = null;
    const THRESHOLD = 130;

    const onScroll = () => {
      let current: string | null = null;
      for (const h of headingEls) {
        if (h.getBoundingClientRect().top - THRESHOLD <= 0) current = h.id;
        else break;
      }
      if (!current) current = headingEls[0].id;

      if (current !== activeId) {
        activeId = current;
        links.forEach((l) => {
          const on = l.dataset.target === current;
          l.classList.toggle("is-active", on);
          if (on) l.setAttribute("aria-current", "location");
          else l.removeAttribute("aria-current");
        });
        const active = map[current];
        if (active) {
          let li = active.closest(".toc-item");
          while (li) {
            const nested = li.querySelector(":scope > .toc-list");
            if (nested) {
              li.classList.remove("is-collapsed");
              const pa = li.querySelector<HTMLElement>(":scope > .toc-link");
              pa?.setAttribute("aria-expanded", "true");
            }
            li = li.parentElement?.closest(".toc-item") ?? null;
          }
        }
      }

      if (progress && content) {
        const rect = content.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        const pct = total > 0 ? (scrolled / total) * 100 : 0;
        progress.style.width = pct + "%";
      }
    };

    const key = "__tocScrollHandler" as keyof Window;
    if (window[key]) window.removeEventListener("scroll", window[key] as any);
    (window as any)[key] = onScroll;
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initToc();

  const container = document.getElementById("main-container");
  if (container) {
    let lastTocBody = document.getElementById("toc-body");
    const mo = new MutationObserver(() => {
      const cur = document.getElementById("toc-body");
      if (cur && cur !== lastTocBody) {
        lastTocBody = cur;
        initToc();
      } else if (!cur) {
        lastTocBody = null;
      }
    });
    mo.observe(container, { childList: true, subtree: true });
  }

  document.addEventListener("spa-navigate", initToc);
</script>
