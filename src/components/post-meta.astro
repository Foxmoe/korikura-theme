---
import Icon from "./icon.astro";
import {
  formatDateToChinese,
  formatRelativeTime,
  getReadingTime,
} from "@/utils/utils";

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  words?: number;
  content?: string;
}
const { pubDate, updatedDate, author, words, content } = Astro.props;

const reading = getReadingTime(content || "", 320);
const total = words ?? reading.words;
---

<div class="post-meta">
  <span class="meta-item" title={formatDateToChinese(pubDate)}>
    <Icon name="calendar" size={15} />
    <span>{formatDateToChinese(pubDate)}</span>
    <span class="meta-sub">（{formatRelativeTime(pubDate)}）</span>
  </span>

  {
    updatedDate && (
      <span class="meta-item" title={`更新于 ${formatDateToChinese(updatedDate)}`}>
        <Icon name="edit" size={15} />
        <span>更新于 {formatDateToChinese(updatedDate)}</span>
      </span>
    )
  }

  <span class="meta-item">
    <Icon name="clock" size={15} />
    <span>约 {reading.minutes} 分钟</span>
  </span>

  <span class="meta-item">
    <Icon name="edit" size={15} />
    <span>{total} 字</span>
  </span>

  {
    author && (
      <span class="meta-item">
        <Icon name="user" size={15} />
        <span>{author}</span>
      </span>
    )
  }
</div>

<style lang="scss">
  .post-meta {
    @apply flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-(--muted);
  }
  .meta-item {
    @apply inline-flex items-center gap-1.5;
  }
  .meta-sub {
    @apply text-xs opacity-70;
  }
</style>
