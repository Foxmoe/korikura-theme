---
import { getTagCounts } from "@/utils/posts";
import { tagToSlug } from "@/utils/utils";
import Icon from "./icon.astro";

const tags = await getTagCounts();
const max = tags.length ? Math.max(...tags.map((t) => t.count)) : 1;
const min = tags.length ? Math.min(...tags.map((t) => t.count)) : 1;

function size(count: number) {
  if (max === min) return 0.95;
  const ratio = (count - min) / (max - min);
  return 0.8 + ratio * 0.6; // 0.8rem ~ 1.4rem
}
---

<div class="card">
  <div class="card-title">
    <Icon name="tag" size={15} />
    <span>标签云</span>
    <a href="/tags" class="card-more" title="全部标签">全部</a>
  </div>
  <div class="cloud">
    {
      tags.map((tag) => (
        <a
          href={`/tags/${tagToSlug(tag.name)}`}
          class="cloud-tag"
          style={`font-size:${size(tag.count).toFixed(2)}rem`}
          title={`${tag.name} · ${tag.count} 篇`}
        >
          {tag.name}
          <sup class="cloud-count">{tag.count}</sup>
        </a>
      ))
    }
  </div>
</div>

<style lang="scss">
  .card-title {
    @apply flex items-center gap-1.5 text-sm font-semibold mb-3 text-[var(--primary)];
  }
  .card-more {
    @apply ml-auto text-xs font-normal text-[var(--muted)] no-underline hover:text-[var(--primary)];
  }
  .cloud {
    @apply flex flex-wrap gap-2;
  }
  .cloud-tag {
    @apply inline-flex items-start px-2.5 py-1 rounded-full no-underline
           bg-[var(--primary)]/8 text-[var(--text)] transition;
    &:hover {
      @apply bg-[var(--primary)]/15 text-[var(--primary)] -translate-y-0.5;
    }
  }
  .cloud-count {
    @apply text-[10px] ml-0.5 text-[var(--muted)];
  }
</style>
