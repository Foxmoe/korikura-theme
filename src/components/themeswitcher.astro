---
import { THEME_DEFAULTS } from "@/constants/constants";

const modes = [
  { value: "light", label: "亮色" },
  { value: "dark", label: "暗色" },
  { value: "read", label: "阅读" },
  { value: "auto", label: "自动" },
];
---

<div id="theme-switcher" class="flex items-center gap-3 p-2 bg-surface-variant rounded-full">
  {modes.map(mode => (
    <button
      type="button"
      data-mode={mode.value}
      class="px-3 py-1 rounded-full text-sm transition-colors hover:bg-primary-container"
    >
      {mode.label}
    </button>
  ))}
  <div class="mx-2 border-l border-outline-variant h-6"></div>
  <label class="flex items-center gap-1 cursor-pointer">
    <input type="color" id="seed-color-picker" value={THEME_DEFAULTS.seedColor}
           class="w-6 h-6 rounded-full border-0 p-0 cursor-pointer" />
  </label>
</div>

<script>
  // 确保在 DOM 加载后执行
  import { generateDynamicSchemes } from "@/theme/dynamic.ts";

  const STORAGE_KEY = "theme-mode";
  const SEED_KEY = "seed-color";
  const picker = document.getElementById("seed-color-picker") as HTMLInputElement | null;
  const buttons = document.querySelectorAll<HTMLButtonElement>("#theme-switcher [data-mode]");

  function getCurrentResolvedMode(): string {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (!stored || stored === "auto") {
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    return stored;
  }

  function applyStoredTheme(mode: string) {
    if (mode === "auto") {
      localStorage.removeItem(STORAGE_KEY);
      const systemMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      window.__applyTheme!(systemMode);
    } else {
      localStorage.setItem(STORAGE_KEY, mode);
      window.__applyTheme!(mode);
    }
  }

  // 按钮点击
  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const mode = btn.dataset.mode!;
      applyStoredTheme(mode);
      updateActiveButton(mode);
    });
  });

  // 高亮当前激活按钮
  function updateActiveButton(mode: string) {
    buttons.forEach(btn => {
      const btnMode = btn.dataset.mode!;
      const isActive = (mode === "auto" && btnMode === "auto") || (mode !== "auto" && btnMode === mode);
      btn.classList.toggle("bg-primary", isActive);
      btn.classList.toggle("text-on-primary", isActive);
    });
  }

  // 初始化高亮
  const storedMode = localStorage.getItem(STORAGE_KEY) || "auto";
  updateActiveButton(storedMode);

  // 颜色选择器
  async function updateColors(newSeedHex: string) {
    try {
      const newSchemes = await generateDynamicSchemes(newSeedHex);
      window.__colorSchemes = newSchemes;
      localStorage.setItem(SEED_KEY, newSeedHex);
      // 重新应用当前模式
      const currentMode = getCurrentResolvedMode();
      window.__applyTheme!(currentMode, newSchemes);
    } catch (err) {
      console.error("Failed to generate theme:", err);
    }
  }

  let debounceTimer: number;
  picker?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer);
    const hex = (e.target as HTMLInputElement).value;
    debounceTimer = window.setTimeout(() => updateColors(hex), 300);
  });

  // 恢复种子色（如果有）
  const savedSeed = localStorage.getItem(SEED_KEY);
  if (savedSeed && picker) {
    picker.value = savedSeed;
  }
</script>