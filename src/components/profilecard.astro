---
import { profileConfig } from "@/config";
import Icon from "./icon.astro";
---

<div class="card profile">
  <div class="pf-top">
    <div class="avatar">
      <img
        src={profileConfig.avatar}
        alt={profileConfig.name}
        class="w-full h-full object-cover rounded-full"
      />
    </div>
    <div class="pf-info">
      <div class="name">{profileConfig.name}</div>
      <div class="desc">{profileConfig.bio}</div>
    </div>
  </div>
  <div class="socials">
    {
      profileConfig.social.map((s) => (
        <a href={s.url} title={s.name} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
          <Icon name={s.icon} size={16} />
        </a>
      ))
    }
  </div>
</div>

<style lang="scss">
  .profile {
    @apply text-left;
  }
  .pf-top {
    @apply flex items-center gap-3;
  }
  .avatar {
    @apply w-16 h-16 rounded-full p-0.5 shrink-0;
    background: color-mix(in oklab, var(--primary) 22%, var(--card-bg));
    img {
      @apply border-2 border-(--card-bg);
    }
  }
  .pf-info {
    @apply min-w-0;
  }
  .name {
    @apply font-bold text-(--text) text-base leading-tight;
  }
  .desc {
    @apply text-xs text-(--muted) mt-1 leading-relaxed line-clamp-2;
  }
  .socials {
    @apply flex items-center gap-2.5 mt-3 pt-3 border-t border-(--border);
    a {
      @apply w-8 h-8 rounded-lg flex items-center justify-center
             border border-(--border) text-(--muted)
             transition hover:text-(--primary) hover:border-(--primary)
             hover:bg-(--primary)/8 active:scale-95;
    }
  }
</style>
