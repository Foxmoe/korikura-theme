---
import { profileConfig } from "@/config";
import Icon from "./icon.astro";
---

<div class="card profile">
  <div class="avatar">
    <img
      src={profileConfig.avatar}
      alt={profileConfig.name}
      class="w-full h-full object-cover rounded-full"
    />
  </div>
  <div class="name">{profileConfig.name}</div>
  <div class="desc">{profileConfig.bio}</div>
  <div class="socials">
    {
      profileConfig.social.map((s) => (
        <a href={s.url} title={s.name} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
          <Icon name={s.icon} size={16} />
        </a>
      ))
    }
  </div>
</div>

<style lang="scss">
  .profile {
    @apply text-center;
  }
  .avatar {
    @apply w-20 h-20 mx-auto rounded-full mb-3 p-0.5;
    background: color-mix(in oklab, var(--primary) 22%, var(--card-bg));
    img {
      @apply border-2 border-(--card-bg);
    }
  }
  .name {
    @apply font-semibold text-(--text);
  }
  .desc {
    @apply text-xs text-(--muted) mt-1 leading-relaxed;
  }
  .socials {
    @apply flex items-center justify-center gap-3 mt-3 text-(--muted);
    a {
      @apply transition hover:text-(--primary) hover:-translate-y-0.5;
    }
  }
</style>
