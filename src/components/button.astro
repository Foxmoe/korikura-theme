---
import "@/styles/sidebar.css";
---

<div class="cardtest">
    <h2 class="title">Button Test</h2>

    <button class="btn"> Click Me </button>
    <button
        class="bg-pink-400 hover:bg-pink-600 text-white px-4 py-2 rounded-xl"
    >
        hover test
    </button>
</div>

<style lang="scss">
    .title {
        font-size: 20px;
        margin-bottom: 12px;
        color: #ff4f93;
    }

    .btn {
        padding: 10px 16px;
        border-radius: 12px;
        cursor: pointer;

        transition: all 0.2s ease;

        background: black;
        color: white;

        &:hover {
            transform: scale(1.08);
            background: #ff4f93;
        }
    }
</style>
