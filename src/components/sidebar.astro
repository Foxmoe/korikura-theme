---
import ProfileCard from "./profilecard.astro";
import RecentPosts from "./recentposts.astro";
import TagsCloud from "./tagscloud.astro";
import GuessYouLike from "./guess-you-like.astro";
import StatWidget from "./stat-widget.astro";
import TableOfContents from "./table-of-contents.astro";
import "@/styles/sidebar.css";

const { headings } = Astro.props;
---

<aside class="sidebar">
    <div class="sidebar-inner">
        <ProfileCard />
        {
            headings?.length > 0 && (
                    <TableOfContents headings={headings} />
            )
        }
        <RecentPosts />
        <GuessYouLike />
        <TagsCloud />
        <StatWidget />
    </div>
</aside>