---
const posts = [
  { title: "樱花落下的那一刻", href: "#" },
  { title: "Astro 动态路由整理", href: "#" },
];
---

<div class="card">
  <div class="title">Recent</div>

  <ul>
    {posts.map(p => (
      <li class="item">
        <a href={p.href}>{p.title}</a>
      </li>
    ))}
  </ul>
</div>

<style lang="scss">
  @use "tailwindcss";

  .title {
    @apply text-sm font-semibold mb-2 text-pink-500;
  }

  .item {
    @apply text-xs py-1 text-gray-600 hover:text-pink-500;
  }
</style>