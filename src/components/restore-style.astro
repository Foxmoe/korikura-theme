---
// 构建期为避免 MDX 解析器无法处理 <span style>，shiki 的内联样式被暂存到
// `data-style` 属性。这里在客户端（首屏与 SPA 导航后）还原为真正的 `style`。
---

<script>
  function restoreInlineStyles() {
    document.querySelectorAll("[data-style]").forEach((el) => {
      const value = el.getAttribute("data-style");
      if (value) el.setAttribute("style", value);
      el.removeAttribute("data-style");
    });
  }

  restoreInlineStyles();
  window.addEventListener("spa-navigate", () => {
    setTimeout(restoreInlineStyles, 60);
  });
</script>
