---
// components/navbar.astro
import { siteConfig } from "@/config";

const navLinks = [
  { href: "/", label: "首页" },
  { href: "/posts", label: "文章" },
  { href: "/about", label: "关于" },
];
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="logo">
      <span class="text-2xl">XX</span>
      <span>{siteConfig.title}</span>
    </a>

    <div class="nav-links">
      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-link">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="sm:hidden">
      <span class="text-on-surface-variant text-sm">菜单</span>
    </div>
  </div>
</nav>

<style lang="scss">
  @use "tailwindcss";
  nav {
    @apply fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b;
  }

  .nav-container {
    @apply max-w-6xl mx-auto px-4 h-16 flex items-center justify-between;
  }

  .logo {
    @apply text-xl font-bold tracking-tight transition-colors duration-200 flex items-center gap-2 hover:text-[#ff6ff0];
  }

  .nav-links {
    @apply hidden sm:flex items-center gap-1;
  }

  .nav-link {
    @apply relative px-4 py-2 text-sm font-medium rounded-full transition-colors duration-200 hover:text-[#ff6ff0];
  }
</style>
