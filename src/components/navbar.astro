---
// components/navbar.astro
import { siteConfig } from "@/config";

const navLinks = [
  { href: "/", label: "首页" },
  { href: "/posts", label: "文章" },
  { href: "/about", label: "关于" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo / 站点名 -->
    <a
      href="/"
      class="text-xl font-bold tracking-tight text-on-surface hover:text-primary transition-colors duration-200 flex items-center gap-2"
    >
      <span class="text-2xl">XX</span>
      <span>{siteConfig.title}</span>
    </a>

    <!-- 导航链接 -->
    <div class="hidden sm:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative px-4 py-2 text-sm font-medium text-on-surface-variant hover:text-on-surface rounded-full transition-colors duration-200 hover:bg-surface-variant/50"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- 移动端占位（可后续加汉堡菜单） -->
    <div class="sm:hidden">
      <span class="text-on-surface-variant text-sm">菜单</span>
    </div>
  </div>
</nav>