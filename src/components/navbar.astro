---
import { siteConfig } from "@/config";
import Icon from "./icon.astro";
import ThemeToggle from "./theme-toggle.astro";
import ProgressBar from "./progressbar.astro";

interface Props {
  postTitle?: string;
}
const { postTitle = "" } = Astro.props;
const isPost = Boolean(postTitle);
---

<nav class={`nav-wrapper${isPost ? " has-post" : ""}`} data-nav="top" aria-label="主导航">
    <div class="nav-card">
      <a href="/" class="logo">
        <img src="/favicon.ico" alt="" class="logo-img" />
        {siteConfig.title}
      </a>

      <div class="nav-center">
        <div class="nav-extra">
          <span class="nav-post-title">{postTitle}</span>
          <button type="button" class="nav-back-top">
            <Icon name="arrow-up" size={14} />
            回顶部
          </button>
        </div>

        <div class="nav-links">
          {
            siteConfig.navLinks.map((i) => (
              <a href={i.href} class="nav-link" data-link={i.href}>
                <span class="nav-link-text">{i.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="actions">
        <button id="search-open" class="icon-btn" type="button" title="搜索" aria-label="搜索" data-ripple>
          <Icon name="search" size={18} />
        </button>
        <ThemeToggle />
        <button id="menu-open" class="icon-btn" type="button" title="菜单" aria-label="菜单" data-ripple>
          <Icon name="menu" size={18} />
        </button>
      </div>

      <ProgressBar />
    </div>

  <div id="mobile-menu" class="mobile-menu">
    {
      siteConfig.navLinks.map((i) => (
        <a href={i.href} class="mobile-link" data-link={i.href}>
          {i.label}
        </a>
      ))
    }
  </div>
</nav>

<style lang="scss" is:global>
  .nav-wrapper {
    @apply fixed top-0 left-0 right-0 z-50 flex flex-col items-center;
    transform: translateZ(0);
  }

  .nav-card {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    @apply relative flex items-center justify-between gap-3 px-4 py-3;
    background-color: color-mix(in oklab, var(--bg) 82%, transparent);
    border: 1px solid transparent;
    border-radius: 0;
    box-shadow: none;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background-color 0.35s ease, border-color 0.35s ease,
      box-shadow 0.35s ease, border-radius 0.35s ease, max-width 0.35s ease,
      padding 0.35s ease;
  }

  .nav-wrapper[data-nav="down"] .nav-card,
  .nav-wrapper[data-nav="up"] .nav-card {
    max-width: min(94vw, var(--container));
    @apply px-5 py-2.5 rounded-xl border mt-1.5;
    border-color: color-mix(in oklab, var(--border) 70%, transparent);
    background-color: color-mix(in oklab, var(--card-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 28px -18px color-mix(in oklab, var(--primary) 22%, transparent);
  }

  .logo {
    @apply font-bold text-base flex items-center gap-2 no-underline text-(--text) shrink-0;
    .logo-img {
      @apply h-7 w-7 rounded-md object-contain;
    }
  }

  .nav-center {
    @apply flex-1 min-w-0 grid;
    grid-template-columns: 1fr;
    grid-template-areas: "c";
  }
  .nav-extra,
  .nav-links {
    grid-area: c;
    @apply min-w-0;
  }
  .nav-extra {
    @apply flex items-center justify-center min-w-0 px-2
           opacity-0 invisible pointer-events-none transition-opacity duration-300;
  }
  .nav-post-title {
    @apply block truncate text-sm font-semibold text-(--text);
  }
  .nav-back-top {
    @apply hidden items-center gap-1 text-sm font-medium no-underline text-(--primary);
  }
  
  .nav-wrapper.has-post[data-nav="down"] .nav-extra {
    @apply visible opacity-100 pointer-events-auto;
  }
  .nav-wrapper.has-post[data-nav="down"] .nav-links {
    @apply opacity-0 invisible pointer-events-none;
  }
  
  .nav-wrapper.has-post[data-nav="up"] .nav-links {
    @apply visible opacity-100 pointer-events-auto;
  }
  .nav-wrapper.has-post[data-nav="up"] .nav-extra {
    @apply opacity-0 invisible pointer-events-none;
  }

  .nav-links {
    @apply hidden sm:flex gap-1 opacity-100 visible transition-opacity duration-300
           min-w-0 overflow-x-auto;
    scrollbar-width: none;
    &::-webkit-scrollbar {
      display: none;
    }
  }
  @media (max-width: 862px) {
    .nav-link {
      @apply px-2.5 text-[13px];
    }
    .nav-links {
      @apply gap-0.5;
    }
  }

  .nav-link {
    @apply relative inline-flex items-center shrink-0 px-3.5 py-1.5 rounded-full
           text-sm no-underline transition active:scale-95 overflow-hidden;
    @apply text-(--text);
    &::before {
      content: "";
      @apply absolute inset-0 rounded-full bg-(--primary)/10;
      transform: scale(0);
      transform-origin: center;
      transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 0;
    }
    .nav-link-text {
      @apply relative z-10;
    }
    &:hover {
      @apply text-(--primary);
    }
    &:hover::before {
      transform: scale(1);
    }
    &.active {
      @apply text-(--primary);
    }
    &.active::before {
      @apply bg-(--primary)/15;
      transform: scale(1);
    }
    &:active::before {
      @apply bg-(--primary)/20;
    }
  }

  .actions {
    @apply flex items-center gap-2 shrink-0;
  }

  .icon-btn {
    @apply flex items-center justify-center w-9 h-9 rounded
           border border-(--border) text-(--text) cursor-pointer
           bg-(--card-bg)/50 transition active:scale-95
           hover:text-(--primary);
  }

  @media (min-width: 640px) {
    #menu-open {
      @apply hidden;
    }
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 12px;
    width: 220px;
    @apply rounded-md border border-(--border) p-2
           flex flex-col gap-1 overflow-hidden
           opacity-0 invisible -translate-y-2 transition-all duration-200;
    background-color: var(--card-bg);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 0 12px 30px -16px color-mix(in oklab, var(--text) 35%, transparent);
    &.open {
      @apply opacity-100 visible translate-y-0;
    }
  }

  .mobile-link {
    @apply px-4 py-2.5 rounded-md text-sm no-underline text-(--text)
           hover:bg-(--primary)/10 active:scale-[0.98] transition;
    &.active {
      @apply bg-(--primary)/15 text-(--primary);
    }
  }
</style>

<script define:vars={{ siteTitle: siteConfig.title }}>
  const wrapper = document.querySelector(".nav-wrapper");
  const navPostTitle = document.querySelector(".nav-post-title");
  const navLinks = document.querySelectorAll(".nav-link, .mobile-link");
  const menu = document.getElementById("mobile-menu");

  function setActive(path) {
    navLinks.forEach((el) => {
      const href = el.dataset.link;
      const isActive =
        href === path || (href !== "/" && path.startsWith(href));
      el.classList.toggle("active", isActive);
      if (isActive) el.setAttribute("aria-current", "page");
      else el.removeAttribute("aria-current");
    });
  }

  function isPostPath(path) {
    return /^\/posts\/.+/.test(path) && !/^\/posts\/page\//.test(path);
  }

  function setPostState(path) {
    if (!wrapper) return;
    const post = isPostPath(path);
    wrapper.classList.toggle("has-post", post);
    if (post && navPostTitle) {
      const escaped = siteTitle.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const t = document.title.replace(
        new RegExp("\\s*-\\s*" + escaped + "$"),
        ""
      );
      navPostTitle.textContent = t || "";
    }
  }

  let lastY = window.scrollY;
  let ticking = false;
  function updateNav() {
    if (!wrapper) return;
    const y = window.scrollY;
    if (y < 12) {
      wrapper.dataset.nav = "top";
    } else if (y > lastY + 2) {
      wrapper.dataset.nav = "down";
    } else if (y < lastY - 2) {
      wrapper.dataset.nav = "up";
    }
    lastY = y;
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateNav);
        ticking = true;
      }
    },
    { passive: true }
  );

  setActive(window.location.pathname);
  setPostState(window.location.pathname);
  updateNav();

  document.addEventListener("click", (e) => {
    const link = e.target?.closest?.(".nav-link, .mobile-link");
    if (link?.dataset.link) setActive(link.dataset.link);
  });

  document.getElementById("menu-open")?.addEventListener("click", () => {
    menu?.classList.toggle("open");
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.classList.remove("open"))
  );

  document.getElementById("search-open")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-search"));
  });

  document.querySelector(".nav-back-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  window.addEventListener("spa-navigate", () => {
    setActive(window.location.pathname);
    setPostState(window.location.pathname);
    lastY = window.scrollY;
    updateNav();
    menu?.classList.remove("open");
  });
</script>
