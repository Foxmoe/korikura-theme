<div id="spa-progress-bar" class="progress-bar-hidden"></div>

<style lang="scss" is:global>
    #spa-progress-bar {
        @apply absolute left-0 bottom-0 z-50 pointer-events-none;
        background: color-mix(in oklab, var(--primary) 80%, transparent);
        border-radius: 1px;
        height: 2px;
        width: 0;
        opacity: 0;
        transition:
            width 0.3s ease-out,
            opacity 0.3s ease-out;

        &.progress-bar-hidden {
            @apply hidden;
        }

        &.progress-bar-visible {
            @apply block;
        }

        &.progress-bar-loading {
            @apply opacity-100;
            width: 80%;
            transition:
                width 2s cubic-bezier(0.1, 0.7, 0.3, 1),
                opacity 0s;
        }

        &.progress-bar-finish {
            width: 100%;
            @apply opacity-0;
            transition:
                width 0.2s ease-out,
                opacity 0.3s ease-out 0.2s;
        }
    }
</style>

<script>
    const bar = document.getElementById("spa-progress-bar") as HTMLElement;

    let timeout: number | NodeJS.Timeout | undefined;
    let isLoading = false;

    function showLoader() {
        if (isLoading) return;
        isLoading = true;
        clearTimeout(timeout);
        bar.classList.remove(
            "progress-bar-finish",
            "progress-bar-hidden",
            "progress-bar-loading",
        );
        bar.classList.add("progress-bar-visible");
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                bar.classList.add("progress-bar-loading");
            });
        });
    }

    function finishLoader() {
        isLoading = false;
        clearTimeout(timeout);
        bar.classList.remove("progress-bar-loading");
        bar.classList.add("progress-bar-finish");
        timeout = setTimeout(() => {
            bar.classList.remove("progress-bar-finish", "progress-bar-visible");
            bar.classList.add("progress-bar-hidden");
        }, 400);
    }

    window.addEventListener("spa-navigate-start", showLoader);
    window.addEventListener("spa-navigate-end", finishLoader);
</script>
