---
import { siteConfig, profileConfig } from "@/config";
import { getPostCount, getTotalWords } from "@/utils/posts";
import Icon from "./icon.astro";

const year = new Date().getFullYear();
const sinceRaw = siteConfig.footer.since;
const startYear =
  typeof sinceRaw === "number" ? sinceRaw : new Date(sinceRaw).getFullYear();
const copyrightRange = startYear === year ? `${year}` : `${startYear}–${year}`;
const postCount = await getPostCount();
const totalWords = await getTotalWords();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-left">
        <p class="copyright">
          © {copyrightRange}
          <a href="/" class="footer-title">{siteConfig.title}</a>
          <span class="footer-by">
            <a
              href="https://github.com/foxmoe"
              class="text-primary"
              target="_blank"
              rel="noopener">KoriKura</a
            > 主题 · 由 <span class="text-primary">Astro</span> 强力驱动
          </span>
        </p>
        {
          (siteConfig.footer.icp || siteConfig.footer.beian) && (
            <p class="beian">
              {siteConfig.footer.icp && <span>{siteConfig.footer.icp}</span>}
              {siteConfig.footer.beian && (
                <a
                  href="https://beian.mps.gov.cn/"
                  target="_blank"
                  rel="noopener"
                >
                  {siteConfig.footer.beian}
                </a>
              )}
            </p>
          )
        }
        <p class="footer-tip">
          本站已运行 <span id="site-runtime" class="runtime">—</span>
          文章总数：{postCount}篇 · 总字数：{totalWords}字
        </p>
        <p class="footer-tip">
          <a href="https://icp.gov.moe/?keyword=20261985" target="_blank"
            >萌ICP备20261985号</a
          >
          <span class="footer-sep">·</span>
          <a
            href={`https://www.busuanzi.cc/count.php?search=${siteConfig.url}`}
            title="不蒜子统计"
            target="_blank"
          >
            <img
              style="width:85px;height:25px;"
              src="https://www.busuanzi.cc/static/images/bsz-tongji.png"
            />
          </a>
          
        </p>
      </div>

      <div class="footer-right">
        <div class="footer-links">
          <a href="/rss.xml" title="RSS 订阅" aria-label="RSS">
            <Icon name="rss" size={18} />
          </a>
          <a href="/sitemap.xml" title="站点地图" aria-label="站点地图">
            <Icon name="hash" size={18} />
          </a>
          {
            profileConfig.social.map((s) => (
              <a
                href={s.url}
                title={s.name}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
              >
                <Icon name={s.icon} size={18} />
              </a>
            ))
          }
        </div>
        <nav class="footer-nav">
          {siteConfig.navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    @apply mt-auto w-full border-t border-[var(--border)];
    background-color: color-mix(in oklab, var(--card-bg) 88%, transparent);
  }
  .footer-container {
    @apply max-w-6xl mx-auto px-4 py-8 flex flex-col gap-4;
  }
  .footer-main {
    @apply flex flex-col sm:flex-row items-center justify-between gap-6;
  }
  .copyright {
    @apply text-sm text-[var(--muted)] m-0;
  }
  .footer-title {
    @apply font-semibold text-[var(--text)] no-underline mx-1;
  }
  .footer-by {
    @apply ml-1;
  }
  .text-primary {
    color: var(--primary);
  }
  .beian {
    @apply flex flex-wrap gap-3 text-xs text-[var(--muted)] mt-1;
    a {
      @apply no-underline hover:text-[var(--primary)];
    }
  }
  .footer-right {
    @apply flex flex-col items-center sm:items-end gap-3;
  }
  .footer-links {
    @apply flex items-center gap-3 text-[var(--muted)];
    a {
      @apply transition hover:text-[var(--primary)] hover:-translate-y-0.5;
    }
  }
  .footer-nav {
    @apply flex flex-wrap items-center gap-x-4 gap-y-1 justify-center sm:justify-end;
    a {
      @apply text-xs text-[var(--muted)] no-underline hover:text-[var(--primary)] transition;
    }
  }
  .footer-tip {
    @apply text-left text-xs text-[var(--muted)] mt-2 flex flex-wrap items-center gap-x-1.5;
  }
  .footer-sep {
    @apply opacity-50;
  }
  .runtime {
    @apply text-[var(--primary)] font-medium;
  }
</style>

<script define:vars={{ sinceValue: sinceRaw }}>
  const el = document.getElementById("site-runtime");
  if (el) {
    const start =
      typeof sinceValue === "number"
        ? new Date(sinceValue, 0, 1).getTime()
        : new Date(sinceValue).getTime();
    const tick = () => {
      const s = Math.max(0, Math.floor((Date.now() - start) / 1000));
      const days = Math.floor(s / 86400);
      const hours = Math.floor((s % 86400) / 3600);
      const mins = Math.floor((s % 3600) / 60);
      const secs = s % 60;
      el.textContent = `${days}天${hours}小时${mins}分钟${secs}秒`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
